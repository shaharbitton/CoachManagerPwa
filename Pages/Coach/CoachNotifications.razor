@page "/coach/notifications"
@inject NotificationService NotificationSvc
@inject NavigationManager Nav

<MudText Typo="Typo.h5" Style="font-weight: bold;" Class="mb-4">
    <MudIcon Icon="@Icons.Material.Filled.Notifications" Class="me-2" />
    ההתראות שלי
</MudText>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!items.Any())
{
    <MudCard Elevation="2" Class="pa-6 rounded-lg">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Style="font-size: 4rem;" Color="Color.Success" />
            <MudText Typo="Typo.h6">אין התראות</MudText>
            <MudText Color="Color.Default">הכל תקין!</MudText>
        </MudStack>
    </MudCard>
}
else
{
    @if (items.Any(i => i.RequiresAction))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            יש התראות הדורשות טיפול. מומלץ לטפל בהן תחילה.
        </MudAlert>
    }

    <MudStack Spacing="3">
        @foreach (var item in items)
        {
            <MudCard Elevation="2" Class="pa-4 rounded-lg">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudIcon Icon="@GetIcon(item.Icon)" Color="@GetColor(item.Color)" Size="Size.Large" />
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.subtitle1" Style="font-weight: bold;">@item.Title</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Default">@item.Message</MudText>
                        </MudStack>
                    </MudStack>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        @if (!string.IsNullOrEmpty(item.ActionHref))
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="@GetColor(item.Color)"
                                       OnClick="@(() => HandleAction(item))">
                                @(item.ActionText ?? "טפל")
                            </MudButton>
                        }
                        @if (!item.RequiresAction)
                        {
                            <MudTooltip Text="סמן כנקרא">
                                <MudIconButton Icon="@Icons.Material.Filled.DoneAll" Size="Size.Small" Color="Color.Default"
                                               OnClick="@(() => Acknowledge(item))" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="דורש טיפול — לא ניתן לסמן כנקרא">
                                <MudIcon Icon="@Icons.Material.Filled.PriorityHigh" Color="Color.Error" Size="Size.Small" />
                            </MudTooltip>
                        }
                    </MudStack>
                </MudStack>
            </MudCard>
        }
    </MudStack>
}

@code {
    private bool loading = true;
    private List<CoachNotificationItem> items = new();

    protected override async Task OnInitializedAsync()
    {
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        try
        {
            items = await NotificationSvc.GetCoachNotificationsAsync();
            await NotificationSvc.RefreshNotificationCountAsync();
        }
        catch { }
        finally { loading = false; }
    }

    private async Task Acknowledge(CoachNotificationItem item)
    {
        await NotificationSvc.AcknowledgeAsync(item.Key);
        items.Remove(item);
        StateHasChanged();
    }

    private async Task HandleAction(CoachNotificationItem item)
    {
        // For one-time notifications, following the action also acknowledges it
        // so it won't reappear after the coach handles it (e.g. re-uploads a rejected document).
        if (!item.RequiresAction)
        {
            await NotificationSvc.AcknowledgeAsync(item.Key);
        }
        if (!string.IsNullOrEmpty(item.ActionHref))
        {
            Nav.NavigateTo(item.ActionHref);
        }
    }

    private static Color GetColor(string color) => color switch
    {
        "Error" => Color.Error,
        "Warning" => Color.Warning,
        "Success" => Color.Success,
        "Primary" => Color.Primary,
        _ => Color.Info
    };

    private static string GetIcon(string icon) => icon switch
    {
        "Draw" => Icons.Material.Filled.Draw,
        "Cancel" => Icons.Material.Filled.Cancel,
        "EventBusy" => Icons.Material.Filled.EventBusy,
        "UploadFile" => Icons.Material.Filled.UploadFile,
        "Schedule" => Icons.Material.Filled.Schedule,
        "HourglassBottom" => Icons.Material.Filled.HourglassBottom,
        _ => Icons.Material.Filled.Notifications
    };
}
