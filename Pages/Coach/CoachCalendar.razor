@page "/coach/calendar"
@using System.Text.Json
@inject IDataService Data
@inject AppState AppState

<MudText Typo="Typo.h5" Style="font-weight: bold;" Class="mb-4">הלו"ז השבועי שלי</MudText>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!scheduleSlots.Any())
{
    <MudCard Elevation="2" Class="pa-6 rounded-lg">
        <MudStack AlignItems="AlignItems.Center" Spacing="3">
            <MudIcon Icon="@Icons.Material.Filled.EventBusy" Style="font-size: 4rem;" Color="Color.Default" />
            <MudText Typo="Typo.h6" Color="Color.Default">לא הוגדר לו"ז בשיבוצים</MudText>
            <MudText Color="Color.Default">לו"ז מוגדר בכל שיבוץ על ידי רכז התפעול</MudText>
        </MudStack>
    </MudCard>
}
else
{
    <MudSimpleTable Dense="true" Hover="true" Bordered="true" Style="direction: rtl;">
        <thead>
            <tr>
                <th style="text-align: center; min-width: 60px;">שעה</th>
                @foreach (var day in DayOrder)
                {
                    <th style="text-align: center;">@DayNames[day]</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var hour in allHours)
            {
                <tr>
                    <td style="text-align: center; font-weight: 600; direction: ltr;">@($"{hour:00}:00")</td>
                    @foreach (var day in DayOrder)
                    {
                        var key = (day, hour);
                        var slots = scheduleSlots.ContainsKey(key) ? scheduleSlots[key] : [];
                        <td style="text-align: center; vertical-align: top; padding: 4px;">
                            @foreach (var slot in slots)
                            {
                                <MudPaper Elevation="0" Class="pa-1 mb-1 rounded" Style="@($"background-color: {slot.Color}20; border-right: 3px solid {slot.Color};")">
                                    <MudText Typo="Typo.caption" Style="font-weight: 600;">@slot.ClientName</MudText>
                                    @if (!string.IsNullOrWhiteSpace(slot.Address))
                                    {
                                        <MudText Typo="Typo.caption" Style="font-size: 0.7rem; color: #666;">@slot.Address</MudText>
                                    }
                                </MudPaper>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </MudSimpleTable>

    <MudStack Row="true" Justify="Justify.FlexStart" Class="mt-3 flex-wrap" Spacing="2">
        @foreach (var legend in clientColors)
        {
            var client = clients.FirstOrDefault(c => c.ClientId == legend.Key);
            <MudChip T="string" Size="Size.Small" Style="@($"background-color: {legend.Value}20; border: 1px solid {legend.Value};")">
                @(client?.ClientName ?? "לקוח")
            </MudChip>
        }
    </MudStack>
}

@code {
    private List<Assignment> assignments = new();
    private List<ClientOrg> clients = new();
    private List<ClientContract> allContracts = new();
    private Dictionary<(string Day, int Hour), List<SlotInfo>> scheduleSlots = new();
    private List<int> allHours = new();
    private Dictionary<string, string> clientColors = new();
    private bool loading = true;

    private static readonly string[] DayOrder = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    private static readonly Dictionary<string, string> DayNames = new()
    {
        ["Sunday"] = "ראשון",
        ["Monday"] = "שני",
        ["Tuesday"] = "שלישי",
        ["Wednesday"] = "רביעי",
        ["Thursday"] = "חמישי",
        ["Friday"] = "שישי",
        ["Saturday"] = "שבת"
    };

    private static readonly string[] Palette =
    [
        "#1976D2", "#388E3C", "#F57C00", "#7B1FA2", "#D32F2F",
        "#0097A7", "#AFB42B", "#5D4037", "#455A64", "#C2185B"
    ];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            assignments = (await Data.GetAssignmentsByCoachAsync(AppState.CurrentUserId))
                .Where(a => a.Status == "Active").ToList();
            clients = await Data.GetClientsAsync();
            allContracts = await Data.GetAllContractsAsync();
            BuildSchedule();
        }
        catch { }
        finally { loading = false; }
    }

    private void BuildSchedule()
    {
        var colorIndex = 0;
        var hoursSet = new HashSet<int>();

        foreach (var assignment in assignments)
        {
            var sched = ParseSchedule(assignment.Schedule);
            if (sched.Count == 0) continue;

            if (!clientColors.ContainsKey(assignment.ClientId))
                clientColors[assignment.ClientId] = Palette[colorIndex++ % Palette.Length];

            var client = clients.FirstOrDefault(c => c.ClientId == assignment.ClientId);
            var color = clientColors[assignment.ClientId];
            var address = BuildAddress(client);
            var clientName = client?.ClientName ?? "לקוח";

            foreach (var (day, hours) in sched)
            {
                foreach (var hour in hours)
                {
                    var key = (day, hour);
                    if (!scheduleSlots.ContainsKey(key))
                        scheduleSlots[key] = new();
                    scheduleSlots[key].Add(new SlotInfo(clientName, address, color));
                    hoursSet.Add(hour);
                }
            }
        }

        allHours = hoursSet.OrderBy(h => h).ToList();
    }

    private static string BuildAddress(ClientOrg? client)
    {
        if (client is null) return "";
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(client.Address)) parts.Add(client.Address);
        if (!string.IsNullOrWhiteSpace(client.City)) parts.Add(client.City);
        return string.Join(", ", parts);
    }

    private static Dictionary<string, List<int>> ParseSchedule(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        try { return JsonSerializer.Deserialize<Dictionary<string, List<int>>>(json) ?? new(); }
        catch { return new(); }
    }

    private record SlotInfo(string ClientName, string Address, string Color);
}
