@page "/admin/coaches"
@using System.Text.Json
@inject IDataService Data
@inject IDialogService Dialog
@inject ISnackbar Snackbar
@inject Supabase.Client SupabaseClient
@inject ILocalityService LocalityService
@inject AppState AppState
@inject BrevoEmailService EmailService

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5" Style="font-weight: bold;">ניהול מאמנים</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenAddDialog">הוסף מאמן</MudButton>
</MudStack>

<MudTextField @bind-Value="searchText" Placeholder="חיפוש לפי שם, מקצוע או תעודת זהות..."
              Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
              Immediate="true" Class="mb-4" />

<MudTable Items="FilteredCoaches" Hover="true" Elevation="2" Dense="true" Loading="loading"
          RowStyle="cursor: pointer;" T="Coach" OnRowClick="OnRowClicked">
    <HeaderContent>
        <MudTh>שם מלא</MudTh>
        <MudTh>טלפון</MudTh>
        <MudTh>תעודת זהות</MudTh>
        <MudTh>מקצוע</MudTh>
        <MudTh>אזורים</MudTh>
        <MudTh>מעמד מיסויי</MudTh>
        <MudTh>לו"ז</MudTh>
        <MudTh>פעולות</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="שם מלא">@context.FirstName @context.LastName</MudTd>
        <MudTd DataLabel="טלפון" Style="direction: ltr;">@context.Phone</MudTd>
        <MudTd DataLabel="תעודת זהות">@context.NationalId</MudTd>
        <MudTd DataLabel="מקצוע">@context.Occupation</MudTd>
        <MudTd DataLabel="אזורים">@GetAreasText(context)</MudTd>
        <MudTd DataLabel="מעמד מיסויי">
            <MudChip T="string" Size="Size.Small" Color="@GetTaxColor(context.TaxStatus)">@GetTaxText(context.TaxStatus)</MudChip>
        </MudTd>
        <MudTd DataLabel="לו&quot;ז">
            <MudIcon Icon="@(string.IsNullOrWhiteSpace(context.PreferredSchedule) ? Icons.Material.Outlined.EventBusy : Icons.Material.Filled.EventAvailable)"
                     Color="@(string.IsNullOrWhiteSpace(context.PreferredSchedule) ? Color.Default : Color.Success)"
                     Size="Size.Small" />
        </MudTd>
        <MudTd DataLabel="פעולות">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditCoach(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteCoach(context))" />
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        @if (context.CoachId == expandedCoachId)
        {
            <MudTr>
                <td colspan="8" style="padding: 12px 24px; background-color: var(--mud-palette-background-gray);">
                    @{ var sched = ParseSchedule(context.PreferredSchedule); }
                    @if (sched.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Default">לא הוגדר לו"ז מועדף</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight: bold;">לו"ז מועדף</MudText>
                        @RenderWeeklyTable(sched)
                    }
                </td>
            </MudTr>
        }
    </ChildRowContent>
    <NoRecordsContent>
        <MudText Align="Align.Center" Class="pa-4">לא נמצאו מאמנים</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<Coach> coaches = new();
    private string searchText = "";
    private bool loading = true;
    private string? expandedCoachId;

    private static readonly string[] DayOrder = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    private static readonly Dictionary<string, string> DayNames = new()
    {
        ["Sunday"] = "ראשון",
        ["Monday"] = "שני",
        ["Tuesday"] = "שלישי",
        ["Wednesday"] = "רביעי",
        ["Thursday"] = "חמישי",
        ["Friday"] = "שישי",
        ["Saturday"] = "שבת"
    };

    private IEnumerable<Coach> FilteredCoaches => string.IsNullOrWhiteSpace(searchText)
        ? coaches
        : coaches.Where(c =>
            $"{c.FirstName} {c.LastName}".Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (c.Occupation ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            c.NationalId.Contains(searchText));

    protected override async Task OnInitializedAsync()
    {
        try { coaches = await Data.GetCoachesAsync(); }
        catch { }
        finally { loading = false; }
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters<CoachDialog>
        {
            { x => x.Coach, new Coach() },
            { x => x.IsNew, true }
        };
        var dialog = await Dialog.ShowAsync<CoachDialog>("הוספת מאמן חדש", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: CoachDialogResult dialogResult })
        {
            try
            {
                // Save admin JWT before SignUp switches the session
                var adminToken = SupabaseClient.Auth.CurrentSession?.AccessToken;

                // 1. Create auth user with default password (email confirmation disabled in Supabase)
                var session = await SupabaseClient.Auth.SignUp(dialogResult.Email, "Coach123!");

                if (session?.User is null)
                {
                    Snackbar.Add("שגיאה ביצירת משתמש באימות", Severity.Error);
                    return;
                }

                var userId = session.User.Id;

                // Re-authenticate as admin (SignUp switches the session to the new user)
                if (!string.IsNullOrEmpty(AppState.AdminEmail) && !string.IsNullOrEmpty(AppState.AdminPassword))
                    await SupabaseClient.Auth.SignIn(AppState.AdminEmail, AppState.AdminPassword);
                await Data.RefreshAuthAsync();

                // 2. Set coach_id to the new auth user id
                dialogResult.Coach.CoachId = userId;

                // 3. Create coach record
                await Data.CreateCoachAsync(dialogResult.Coach);
                coaches.Add(dialogResult.Coach);

                // 4. Send welcome email via Edge Function (using saved admin token)
                try
                {
                    await EmailService.SendWelcomeEmailAsync(dialogResult.Email, dialogResult.Coach.FirstName, adminToken);
                    Snackbar.Add($"מאמן נוצר בהצלחה! מייל עם פרטי כניסה נשלח ל-{dialogResult.Email}", Severity.Success);
                }
                catch (Exception emailEx)
                {
                    Console.WriteLine($"Brevo email error: {emailEx.Message}");
                    Snackbar.Add($"מאמן נוצר בהצלחה! שליחת המייל נכשלה ({emailEx.Message}) — פרטי כניסה: {dialogResult.Email} / Coach123!", Severity.Warning);
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"שגיאה: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task EditCoach(Coach coach)
    {
        var parameters = new DialogParameters<CoachDialog> { { x => x.Coach, coach }, { x => x.IsNew, false } };
        var dialog = await Dialog.ShowAsync<CoachDialog>("עריכת מאמן", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: CoachDialogResult dialogResult })
        {
            try
            {
                await Data.UpdateCoachAsync(dialogResult.Coach);
                Snackbar.Add("מאמן עודכן בהצלחה", Severity.Success);
                coaches = await Data.GetCoachesAsync();
            }
            catch (Exception ex) { Snackbar.Add($"שגיאה: {ex.Message}", Severity.Error); }
        }
    }

    private async Task DeleteCoach(Coach coach)
    {
        var parameters = new DialogParameters<ConfirmDeleteDialog>
        {
            { x => x.Message, $"האם אתה בטוח שברצונך למחוק את המאמן {coach.FirstName} {coach.LastName}? פעולה זו תמחק גם את המשתמש המקושר ואינה ניתנת לביטול." }
        };
        var dialog = await Dialog.ShowAsync<ConfirmDeleteDialog>("אישור מחיקה", parameters);
        var result = await dialog.Result;
        if (result is null or { Canceled: true }) return;

        try
        {
            // 1. Delete the public users record (cascades to coaches via FK)
            await Data.DeleteUserAsync(coach.CoachId);

            // 2. Delete the auth user via DB function
            try { await Data.DeleteAuthUserAsync(coach.CoachId); }
            catch (Exception authEx) { Console.WriteLine($"Failed to delete auth user: {authEx.Message}"); }

            coaches.Remove(coach);
            Snackbar.Add("מאמן נמחק", Severity.Warning);
        }
        catch (Exception ex)
        {
            var message = ex.Message switch
            {
                var m when m.Contains("23503") && m.Contains("assignments") =>
                    $"לא ניתן למחוק את {coach.FirstName} {coach.LastName} — קיימים שיבוצים המשויכים למאמן זה. יש להסיר את השיבוצים לפני המחיקה.",
                var m when m.Contains("23503") && m.Contains("time_entries") =>
                    $"לא ניתן למחוק את {coach.FirstName} {coach.LastName} — קיימים דיווחי שעות המשויכים למאמן זה.",
                var m when m.Contains("23503") && m.Contains("coach_documents") =>
                    $"לא ניתן למחוק את {coach.FirstName} {coach.LastName} — קיימים מסמכים המשויכים למאמן זה.",
                var m when m.Contains("23503") =>
                    $"לא ניתן למחוק את {coach.FirstName} {coach.LastName} — קיימים רשומות המקושרות למאמן זה במערכת.",
                _ => $"שגיאה: {ex.Message}"
            };
            Snackbar.Add(message, Severity.Error);
        }
    }

    private Color GetTaxColor(string status) => status switch
    {
        "Employee" => Color.Info,
        "Exempt_Dealer" => Color.Warning,
        "Licensed_Dealer" => Color.Success,
        _ => Color.Default
    };

    private string GetTaxText(string status) => status switch
    {
        "Employee" => "שכיר",
        "Exempt_Dealer" => "עוסק פטור",
        "Licensed_Dealer" => "עוסק מורשה",
        _ => status
    };

    private string GetAreasText(Coach coach)
    {
        if (coach.AvailabilityArea is { Count: > 0 })
            return string.Join(", ", coach.AvailabilityArea);
        return "—";
    }

    private void OnRowClicked(TableRowClickEventArgs<Coach> args)
    {
        expandedCoachId = expandedCoachId == args.Item.CoachId ? null : args.Item.CoachId;
    }

    private Dictionary<string, List<int>> ParseSchedule(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        try { return JsonSerializer.Deserialize<Dictionary<string, List<int>>>(json) ?? new(); }
        catch { return new(); }
    }

    private RenderFragment RenderWeeklyTable(Dictionary<string, List<int>> sched) => __builder =>
    {
        var allHours = DayOrder.Where(d => sched.ContainsKey(d)).SelectMany(d => sched[d]).Distinct().OrderBy(h => h).ToList();

        <MudSimpleTable Dense="true" Hover="true" Bordered="true" Style="max-width: 600px; direction: rtl;">
            <thead>
                <tr>
                    <th style="text-align: center;">שעה</th>
                    @foreach (var day in DayOrder)
                    {
                        <th style="text-align: center;">@DayNames[day]</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var hour in allHours)
                {
                    <tr>
                        <td style="text-align: center; font-weight: 600; direction: ltr;">@($"{hour:00}:00")</td>
                        @foreach (var day in DayOrder)
                        {
                            var active = sched.TryGetValue(day, out var hours) && hours.Contains(hour);
                            <td style="text-align: center;">
                                @if (active)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" />
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    };
}
