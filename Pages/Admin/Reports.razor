@page "/admin/reports"
@inject IDataService Data
@inject ISnackbar Snackbar
@inject IFeatureService FeatureService

@if (!FeatureService.IsAvailable(FeatureTier.Pro))
{
    <MudAlert Severity="Severity.Info" Class="mt-4">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudIcon Icon="@Icons.Material.Filled.Lock" />
            <MudText>מערכת הדוחות זמינה בדרגת Pro ומעלה.</MudText>
        </MudStack>
    </MudAlert>
    return;
}

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5" Style="font-weight: bold;">📊 דוחות</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        @if (lastLoaded.HasValue)
        {
            <MudText Typo="Typo.caption" Color="Color.Default">עודכן: @lastLoaded.Value.ToString("HH:mm:ss")</MudText>
        }
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="ReloadData" Disabled="loading">רענן נתונים</MudButton>
    </MudStack>
</MudStack>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}

<MudTabs @bind-ActivePanelIndex="activeTab" Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4"
         AlwaysShowScrollButtons="true" ScrollIcon="@Icons.Material.Filled.ChevronRight" SliderColor="Color.Primary"
         Disabled="loading">
    <MudTabPanel Text="תשלום חודשי" Icon="@Icons.Material.Filled.Payments">
        <ReportMonthlyPayment Coaches="coaches" Clients="clients" Assignments="assignments" TimeEntries="timeEntries" AllRates="allRates" AllContracts="allContracts" />
    </MudTabPanel>
    <MudTabPanel Text="סיכום שנתי" Icon="@Icons.Material.Filled.CalendarMonth">
        <ReportYearlySummary Coaches="coaches" Assignments="assignments" TimeEntries="timeEntries" AllRates="allRates" />
    </MudTabPanel>
    <MudTabPanel Text="רווחיות" Icon="@Icons.Material.Filled.TrendingUp">
        <ReportProfitability Clients="clients" Assignments="assignments" TimeEntries="timeEntries" AllRates="allRates" AllContracts="allContracts" />
    </MudTabPanel>
    <MudTabPanel Text="רווחיות צפויה" Icon="@Icons.Material.Filled.Insights">
        <ReportExpectedProfitability Coaches="coaches" Clients="clients" Assignments="assignments" AllRates="allRates" AllContracts="allContracts" />
    </MudTabPanel>
    <MudTabPanel Text="ניצול שעות" Icon="@Icons.Material.Filled.PieChart">
        <ReportHoursUtilization Clients="clients" Assignments="assignments" TimeEntries="timeEntries" AllContracts="allContracts" />
    </MudTabPanel>
    <MudTabPanel Text="פעילות מאמנים" Icon="@Icons.Material.Filled.People">
        <ReportCoachActivity Coaches="coaches" Assignments="assignments" TimeEntries="timeEntries" />
    </MudTabPanel>
    <MudTabPanel Text="חיוב ללקוח" Icon="@Icons.Material.Filled.Receipt">
        <ReportClientBilling Coaches="coaches" Clients="clients" Assignments="assignments" TimeEntries="timeEntries" AllContracts="allContracts" />
    </MudTabPanel>
    <MudTabPanel Text="השוואה תקופתית" Icon="@Icons.Material.Filled.CompareArrows">
        <ReportPeriodComparison Assignments="assignments" TimeEntries="timeEntries" AllContracts="allContracts" />
    </MudTabPanel>
</MudTabs>

@code {
    private bool loading = true;
    private int activeTab;
    private DateTime? lastLoaded;
    private List<Coach> coaches = new();
    private List<ClientOrg> clients = new();
    private List<Assignment> assignments = new();
    private List<TimeEntry> timeEntries = new();
    private List<CoachRate> allRates = new();
    private List<ClientContract> allContracts = new();

    protected override async Task OnInitializedAsync()
    {
        await ReloadData();
    }

    private async Task ReloadData()
    {
        loading = true;
        try
        {
            coaches = await Data.GetCoachesAsync();
            clients = await Data.GetClientsAsync();
            assignments = await Data.GetAssignmentsAsync();
            timeEntries = await Data.GetTimeEntriesAsync();
            allContracts = await Data.GetAllContractsAsync();
            allRates = new();
            foreach (var coach in coaches)
                allRates.AddRange(await Data.GetRatesByCoachAsync(coach.CoachId));
            lastLoaded = DateTime.Now;
        }
        catch (Exception ex) { Snackbar.Add($"שגיאה: {ex.Message}", Severity.Error); }
        finally { loading = false; }
    }
}
