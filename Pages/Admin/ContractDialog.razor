@using System.Text.Json

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="Contract.EngagementName" Label="שם התקשרות" Variant="Variant.Outlined" Class="mb-3"
                      Placeholder="לדוגמה: יום שיא, התקשרות כללית, חוג ילדים מתנס" />
        <MudNumericField T="decimal" @bind-Value="Contract.BillingRatePerHour" Label="תעריף חיוב לשעה (₪)" Variant="Variant.Outlined" Required="true" />
        <MudNumericField T="decimal?" @bind-Value="Contract.WorkScopeHours" Label="היקף שעות מאושר" Variant="Variant.Outlined" Class="mt-3" />
        <MudTextField @bind-Value="Contract.PaymentTerms" Label="תנאי תשלום" Variant="Variant.Outlined" Class="mt-3" Placeholder="שוטף + 30" />
        <MudSelect T="string" @bind-Value="Contract.PaymentMethod" Label="אמצעי תשלום" Variant="Variant.Outlined" Class="mt-3" Clearable="true">
            <MudSelectItem Value="@("BankTransfer")">העברה בנקאית</MudSelectItem>
            <MudSelectItem Value="@("Check")">צ'ק</MudSelectItem>
            <MudSelectItem Value="@("Cash")">מזומן</MudSelectItem>
            <MudSelectItem Value="@("CreditCard")">כרטיס אשראי</MudSelectItem>
        </MudSelect>
        <MudDatePicker @bind-Date="startDate" Label="תחילת הסכם" Variant="Variant.Outlined" Class="mt-3" />
        <MudDatePicker @bind-Date="endDate" Label="סיום הסכם" Variant="Variant.Outlined" Class="mt-3" />

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle1" Class="mb-2" Style="font-weight: bold;">ימים ושעות מועדפים</MudText>

        @foreach (var day in DayNames)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="2">
                <MudCheckBox T="bool" Value="@IsDaySelected(day.Key)" ValueChanged="@((bool v) => ToggleDay(day.Key, v))"
                             Label="@day.Value" Style="min-width: 90px;" Dense="true" />
                @if (IsDaySelected(day.Key))
                {
                    <MudStack Spacing="1">
                        <MudStack Row="true" Spacing="1" Style="flex-wrap: wrap; direction: ltr;">
                            @foreach (var hour in GetVisibleHours(day.Key))
                            {
                                var h = hour;
                                var selected = IsHourSelected(day.Key, h);
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(selected ? Color.Primary : Color.Default)"
                                         Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                         OnClick="@(() => ToggleHour(day.Key, h))"
                                         Style="min-width: 52px; cursor: pointer; direction: ltr;">
                                    @($"{h:00}:00")
                                </MudChip>
                            }
                        </MudStack>
                        <MudLink OnClick="@(() => ToggleExpandDay(day.Key))" Underline="Underline.Always" Typo="Typo.caption" Style="cursor: pointer;">
                            @(IsExpanded(day.Key) ? "הצג פחות" : "הצג את כל השעות")
                        </MudLink>
                    </MudStack>
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">ביטול</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@(IsNew ? "הוסף" : "עדכן")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ClientContract Contract { get; set; } = new();
    [Parameter] public bool IsNew { get; set; } = true;

    private DateTime? startDate = DateTime.Today;
    private DateTime? endDate;
    private Dictionary<string, List<int>> schedule = new();
    private HashSet<string> expandedDays = new();

    private static readonly Dictionary<string, string> DayNames = new()
    {
        ["Sunday"] = "ראשון",
        ["Monday"] = "שני",
        ["Tuesday"] = "שלישי",
        ["Wednesday"] = "רביעי",
        ["Thursday"] = "חמישי",
        ["Friday"] = "שישי",
        ["Saturday"] = "שבת"
    };

    protected override void OnParametersSet()
    {
        if (!IsNew)
        {
            startDate = Contract.StartDate;
            endDate = Contract.EndDate;
        }

        if (!string.IsNullOrWhiteSpace(Contract.PreferredSchedule))
        {
            try
            {
                schedule = JsonSerializer.Deserialize<Dictionary<string, List<int>>>(Contract.PreferredSchedule) ?? new();
            }
            catch { schedule = new(); }
        }
        else
        {
            schedule = new();
        }
    }

    private bool IsDaySelected(string day) => schedule.TryGetValue(day, out var hours) && hours.Count > 0;

    private bool IsHourSelected(string day, int hour) => schedule.TryGetValue(day, out var hours) && hours.Contains(hour);

    private bool IsExpanded(string day) => expandedDays.Contains(day);

    private IEnumerable<int> GetVisibleHours(string day)
    {
        if (expandedDays.Contains(day))
            return Enumerable.Range(0, 24);
        return Enumerable.Range(8, 9); // 8:00–16:00
    }

    private void ToggleExpandDay(string day)
    {
        if (!expandedDays.Add(day))
            expandedDays.Remove(day);
    }

    private void ToggleDay(string day, bool selected)
    {
        if (selected)
        {
            schedule[day] = new List<int> { 8, 9, 10, 11, 12, 13, 14, 15, 16 };
        }
        else
        {
            schedule.Remove(day);
        }
    }

    private void ToggleHour(string day, int hour)
    {
        if (!schedule.ContainsKey(day))
            schedule[day] = new List<int>();

        if (schedule[day].Contains(hour))
            schedule[day].Remove(hour);
        else
            schedule[day].Add(hour);

        schedule[day].Sort();
    }

    private void Submit()
    {
        if (startDate.HasValue) Contract.StartDate = DateTime.SpecifyKind(startDate.Value.Date, DateTimeKind.Utc);
        Contract.EndDate = endDate.HasValue ? DateTime.SpecifyKind(endDate.Value.Date, DateTimeKind.Utc) : null;

        // Serialize schedule — only include days with hours
        var filtered = schedule.Where(kv => kv.Value.Count > 0).ToDictionary(kv => kv.Key, kv => kv.Value);
        Contract.PreferredSchedule = filtered.Count > 0 ? JsonSerializer.Serialize(filtered) : null;

        MudDialog.Close(DialogResult.Ok(Contract));
    }

    private void Cancel() => MudDialog.Cancel();
}
