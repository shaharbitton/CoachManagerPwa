@page "/admin/clients"
@inject IDataService Data
@inject IDialogService Dialog
@inject ISnackbar Snackbar
@inject ILocalityService LocalityService
@inject IJSRuntime JS

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5" Style="font-weight: bold;">ניהול לקוחות ומוסדות</MudText>
    <MudStack Row="true" Spacing="2">
        <FeatureGate RequiredTier="FeatureTier.Pro" ShowLock="true">
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportBackupScript">ייצוא סקריפט גיבוי</MudButton>
        </FeatureGate>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddBusiness" OnClick="OpenAddDialog">הוסף לקוח</MudButton>
    </MudStack>
</MudStack>

<MudTextField @bind-Value="searchText" Placeholder="חיפוש לפי שם, עיר או סוג..."
              Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
              Immediate="true" Class="mb-4" />

<MudTable Items="FilteredClients" Hover="true" Elevation="2" Dense="true" Loading="loading">
    <HeaderContent>
        <MudTh>שם הלקוח</MudTh>
        <MudTh>סוג</MudTh>
        <MudTh>עיר</MudTh>
        <MudTh>סטטוס</MudTh>
        <MudTh>פעולות</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="שם הלקוח">@context.ClientName</MudTd>
        <MudTd DataLabel="סוג"><MudChip T="string" Size="Size.Small" Color="Color.Info">@GetTypeText(context.ClientType)</MudChip></MudTd>
        <MudTd DataLabel="עיר">@context.City</MudTd>
        <MudTd DataLabel="סטטוס">
            <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                @(context.IsActive ? "פעיל" : "לא פעיל")
            </MudChip>
        </MudTd>
        <MudTd DataLabel="פעולות">
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditClient(context))" />
            <MudTooltip Text="מאמנים מומלצים לפי אזור">
                <MudIconButton Icon="@Icons.Material.Filled.TipsAndUpdates" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => ShowRecommendedCoaches(context))" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <MudText Align="Align.Center" Class="pa-4">לא נמצאו לקוחות</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<ClientOrg> clients = new();
    private string searchText = "";
    private bool loading = true;

    private IEnumerable<ClientOrg> FilteredClients => string.IsNullOrWhiteSpace(searchText)
        ? clients
        : clients.Where(c =>
            c.ClientName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (c.City ?? "").Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            c.ClientType.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    private List<Coach> allCoaches = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            clients = await Data.GetClientsAsync();
            allCoaches = await Data.GetCoachesAsync();
            await LocalityService.InitializeAsync();
        }
        catch { }
        finally { loading = false; }
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters<ClientDialog> { { x => x.Client, new ClientOrg() }, { x => x.IsNew, true } };
        var dialog = await Dialog.ShowAsync<ClientDialog>("הוספת לקוח חדש", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ClientOrg newClient })
        {
            try
            {
                await Data.CreateClientAsync(newClient);
                clients.Add(newClient);
                Snackbar.Add("לקוח נוסף בהצלחה", Severity.Success);
            }
            catch (Exception ex) { Snackbar.Add($"שגיאה: {ex.Message}", Severity.Error); }
        }
    }

    private async Task EditClient(ClientOrg client)
    {
        var parameters = new DialogParameters<ClientDialog> { { x => x.Client, client }, { x => x.IsNew, false } };
        var dialog = await Dialog.ShowAsync<ClientDialog>("עריכת לקוח", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ClientOrg updated })
        {
            try
            {
                await Data.UpdateClientAsync(updated);
                Snackbar.Add("לקוח עודכן", Severity.Success);
                clients = await Data.GetClientsAsync();
            }
            catch (Exception ex) { Snackbar.Add($"שגיאה: {ex.Message}", Severity.Error); }
        }
    }

    private void ShowRecommendedCoaches(ClientOrg client)
    {
        if (string.IsNullOrEmpty(client.City))
        {
            Snackbar.Add("ללקוח זה לא הוגדרה עיר — לא ניתן להמליץ", Severity.Warning);
            return;
        }

        var recommended = LocalityService.GetRecommendedCoaches(client.City, allCoaches);
        if (!recommended.Any())
        {
            Snackbar.Add($"לא נמצאו מאמנים באזור של {client.City}", Severity.Info);
            return;
        }

        var names = string.Join(", ", recommended.Select(c => $"{c.FirstName} {c.LastName}"));
        var subDistrict = LocalityService.GetSubDistrictForLocality(client.City);
        Snackbar.Add($"נפת {subDistrict}: {names}", Severity.Info, config => config.VisibleStateDuration = 8000);
    }

    private string GetTypeText(string type) => type switch
    {
        "School" => "בית ספר",
        "Community_Center" => "מתנ\"ס",
        "NGO" => "עמותה",
        "Private_Client" => "פרטי",
        _ => type
    };

    private async Task ExportBackupScript()
    {
        if (clients.Count == 0)
        {
            Snackbar.Add("אין לקוחות לייצוא", Severity.Warning);
            return;
        }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("-- ========================================");
        sb.AppendLine($"-- סקריפט גיבוי לקוחות — Coach Manager");
        sb.AppendLine($"-- תאריך ייצוא: {DateTime.Now:yyyy-MM-dd HH:mm}");
        sb.AppendLine($"-- מספר לקוחות: {clients.Count}");
        sb.AppendLine("-- ========================================");
        sb.AppendLine();
        sb.AppendLine("-- מחיקת לקוחות קיימים (אופציונלי — הסר הערה אם רוצים לאפס)");
        sb.AppendLine("-- DELETE FROM clients;");
        sb.AppendLine();
        sb.AppendLine("INSERT INTO clients (client_id, client_name, tax_id, client_type, address, city, management_email, management_phone, accounting_email, accounting_phone, secretariat_email, secretariat_phone, is_active, created_at)");
        sb.AppendLine("VALUES");

        for (int i = 0; i < clients.Count; i++)
        {
            var c = clients[i];
            var comma = i < clients.Count - 1 ? "," : ";";
            sb.AppendLine($"  ('{Esc(c.ClientId)}', '{Esc(c.ClientName)}', {NullOrStr(c.TaxId)}, '{Esc(c.ClientType)}', {NullOrStr(c.Address)}, {NullOrStr(c.City)}, {NullOrStr(c.ManagementEmail)}, {NullOrStr(c.ManagementPhone)}, {NullOrStr(c.AccountingEmail)}, {NullOrStr(c.AccountingPhone)}, {NullOrStr(c.SecretariatEmail)}, {NullOrStr(c.SecretariatPhone)}, {(c.IsActive ? "true" : "false")}, '{c.CreatedAt:yyyy-MM-dd HH:mm:ss}'){comma}");
        }

        sb.AppendLine();
        sb.AppendLine("-- ON CONFLICT — אם רוצים upsert במקום insert:");
        sb.AppendLine("-- הוסף בסוף כל INSERT:");
        sb.AppendLine("-- ON CONFLICT (client_id) DO UPDATE SET");
        sb.AppendLine("--   client_name = EXCLUDED.client_name,");
        sb.AppendLine("--   tax_id = EXCLUDED.tax_id,");
        sb.AppendLine("--   client_type = EXCLUDED.client_type,");
        sb.AppendLine("--   address = EXCLUDED.address,");
        sb.AppendLine("--   city = EXCLUDED.city,");
        sb.AppendLine("--   management_email = EXCLUDED.management_email,");
        sb.AppendLine("--   management_phone = EXCLUDED.management_phone,");
        sb.AppendLine("--   accounting_email = EXCLUDED.accounting_email,");
        sb.AppendLine("--   accounting_phone = EXCLUDED.accounting_phone,");
        sb.AppendLine("--   secretariat_email = EXCLUDED.secretariat_email,");
        sb.AppendLine("--   secretariat_phone = EXCLUDED.secretariat_phone,");
        sb.AppendLine("--   is_active = EXCLUDED.is_active;");

        var fileName = $"clients_backup_{DateTime.Now:yyyyMMdd_HHmm}.sql";
        await JS.InvokeVoidAsync("downloadFile", fileName, sb.ToString(), "text/sql;charset=utf-8");
        Snackbar.Add($"סקריפט גיבוי הורד — {clients.Count} לקוחות", Severity.Success);
    }

    private static string Esc(string s) => (s ?? "").Replace("'", "''");
    private static string NullOrStr(string? s) => s == null ? "NULL" : $"'{Esc(s)}'";
}
