@page "/admin/contracts"
@using System.Text.Json
@inject IDataService Data
@inject IDialogService Dialog
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Style="font-weight: bold;" Class="mb-4">חוזי התקשרות עם לקוחות</MudText>
<MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">מידע זה חסום לחלוטין לצפיית מאמנים - נגיש למנהלים בלבד</MudAlert>

<MudSelect T="string" Value="selectedClientId" ValueChanged="LoadContracts" Label="בחר לקוח" Variant="Variant.Outlined" Class="mb-4">
    @foreach (var c in clients)
    {
        <MudSelectItem Value="@c.ClientId">@c.ClientName</MudSelectItem>
    }
</MudSelect>

@if (!string.IsNullOrEmpty(selectedClientId))
{
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
        <MudText Typo="Typo.h6">הסכמים פעילים</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="AddContract">הוסף הסכם</MudButton>
    </MudStack>

    <MudTable Items="contracts" Hover="true" Elevation="2" Dense="true" T="ClientContract" OnRowClick="OnRowClicked">
        <HeaderContent>
            <MudTh>שם התקשרות</MudTh>
            <MudTh>תעריף חיוב (₪/שעה)</MudTh>
            <MudTh>היקף שעות</MudTh>
            <MudTh>תנאי תשלום</MudTh>
            <MudTh>אמצעי תשלום</MudTh>
            <MudTh>תקופה</MudTh>
            <MudTh>לו"ז</MudTh>
            <MudTh>פעולות</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="שם התקשרות" Style="font-weight: bold;">@(string.IsNullOrWhiteSpace(context.EngagementName) ? "כללי" : context.EngagementName)</MudTd>
            <MudTd DataLabel="תעריף חיוב (₪/שעה)">₪@context.BillingRatePerHour</MudTd>
            <MudTd DataLabel="היקף שעות">@context.WorkScopeHours</MudTd>
            <MudTd DataLabel="תנאי תשלום">@context.PaymentTerms</MudTd>
            <MudTd DataLabel="אמצעי תשלום">@GetPaymentMethodText(context.PaymentMethod)</MudTd>
            <MudTd DataLabel="תקופה">@context.StartDate.ToString("dd/MM/yyyy") - @(context.EndDate?.ToString("dd/MM/yyyy") ?? "פתוח")</MudTd>
            <MudTd DataLabel="לו&quot;ז">
                <MudIcon Icon="@(string.IsNullOrWhiteSpace(context.PreferredSchedule) ? Icons.Material.Outlined.EventBusy : Icons.Material.Filled.EventAvailable)"
                         Color="@(string.IsNullOrWhiteSpace(context.PreferredSchedule) ? Color.Default : Color.Success)"
                         Size="Size.Small" />
            </MudTd>
            <MudTd DataLabel="פעולות">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditContract(context))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteContract(context))" />
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            @if (context.ContractId == expandedContractId)
            {
                <MudTr>
                    <td colspan="8" style="padding: 12px 24px; background-color: var(--mud-palette-background-gray);">
                        @{ var sched = ParseSchedule(context.PreferredSchedule); }
                        @if (sched.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Default">לא הוגדר לו"ז מועדף</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight: bold;">לו"ז מועדף</MudText>
                            @RenderWeeklyTable(sched)
                        }
                    </td>
                </MudTr>
            }
        </ChildRowContent>
    </MudTable>
}

@code {
    private List<ClientOrg> clients = new();
    private List<ClientContract> contracts = new();
    private string selectedClientId = "";
    private string? expandedContractId;

    private static readonly string[] DayOrder = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    private static readonly Dictionary<string, string> DayNames = new()
    {
        ["Sunday"] = "ראשון",
        ["Monday"] = "שני",
        ["Tuesday"] = "שלישי",
        ["Wednesday"] = "רביעי",
        ["Thursday"] = "חמישי",
        ["Friday"] = "שישי",
        ["Saturday"] = "שבת"
    };

    protected override async Task OnInitializedAsync()
    {
        try { clients = await Data.GetClientsAsync(); } catch { }
    }

    private async Task LoadContracts(string clientId)
    {
        selectedClientId = clientId;
        if (string.IsNullOrEmpty(clientId)) return;
        try { contracts = await Data.GetContractsByClientAsync(clientId); } catch { }
    }

    private async Task AddContract()
    {
        var contract = new ClientContract { ClientId = selectedClientId };
        var parameters = new DialogParameters<ContractDialog> { { x => x.Contract, contract }, { x => x.IsNew, true } };
        var dialog = await Dialog.ShowAsync<ContractDialog>("הוספת הסכם", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ClientContract newContract })
        {
            try
            {
                await Data.CreateContractAsync(newContract);
                contracts = await Data.GetContractsByClientAsync(selectedClientId);
                Snackbar.Add("הסכם נוסף", Severity.Success);
            }
            catch (Exception ex) { Snackbar.Add($"שגיאה: {ex.Message}", Severity.Error); }
        }
    }

    private async Task EditContract(ClientContract contract)
    {
        var parameters = new DialogParameters<ContractDialog> { { x => x.Contract, contract }, { x => x.IsNew, false } };
        var dialog = await Dialog.ShowAsync<ContractDialog>("עריכת הסכם", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: ClientContract updated })
        {
            try
            {
                await Data.UpdateContractAsync(updated);
                contracts = await Data.GetContractsByClientAsync(selectedClientId);
                Snackbar.Add("הסכם עודכן", Severity.Success);
            }
            catch (Exception ex) { Snackbar.Add($"שגיאה: {ex.Message}", Severity.Error); }
        }
    }

    private async Task DeleteContract(ClientContract contract)
    {
        try
        {
            await Data.DeleteContractAsync(contract.ContractId);
            contracts = await Data.GetContractsByClientAsync(selectedClientId);
            Snackbar.Add("הסכם נמחק", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"שגיאה: {ex.Message}", Severity.Error); }
    }

    private string GetPaymentMethodText(string? method) => method switch
    {
        "BankTransfer" => "העברה בנקאית",
        "Check" => "צ'ק",
        "Cash" => "מזומן",
        "CreditCard" => "כרטיס אשראי",
        _ => "—"
    };

    private void OnRowClicked(TableRowClickEventArgs<ClientContract> args)
    {
        expandedContractId = expandedContractId == args.Item.ContractId ? null : args.Item.ContractId;
    }

    private Dictionary<string, List<int>> ParseSchedule(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        try { return JsonSerializer.Deserialize<Dictionary<string, List<int>>>(json) ?? new(); }
        catch { return new(); }
    }

    private RenderFragment RenderWeeklyTable(Dictionary<string, List<int>> sched) => __builder =>
    {
        var allHours = DayOrder.Where(d => sched.ContainsKey(d)).SelectMany(d => sched[d]).Distinct().OrderBy(h => h).ToList();

        <MudSimpleTable Dense="true" Hover="true" Bordered="true" Style="max-width: 600px; direction: rtl;">
            <thead>
                <tr>
                    <th style="text-align: center;">שעה</th>
                    @foreach (var day in DayOrder)
                    {
                        <th style="text-align: center;">@DayNames[day]</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var hour in allHours)
                {
                    <tr>
                        <td style="text-align: center; font-weight: 600; direction: ltr;">@($"{hour:00}:00")</td>
                        @foreach (var day in DayOrder)
                        {
                            var active = sched.TryGetValue(day, out var hours) && hours.Contains(hour);
                            <td style="text-align: center;">
                                @if (active)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" />
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    };
}
