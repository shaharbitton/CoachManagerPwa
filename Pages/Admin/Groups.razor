@page "/admin/groups"
@using CoachManagerPwa.Pages.Coach
@inject IDataService Data
@inject IDialogService Dialog
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Style="font-weight: bold;" Class="mb-4">צפייה בקבוצות - כלל המאמנים</MudText>

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="6">
        <MudAutocomplete T="Coach" Value="selectedCoach" ValueChanged="OnCoachSelectedChanged" Label="סנן לפי מאמן" Variant="Variant.Outlined" Clearable="true" Dense="true"
                         ToStringFunc="CoachToString" SearchFunc="SearchCoaches" CoerceText="true" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudAutocomplete T="ClientOrg" Value="selectedClient" ValueChanged="OnClientSelectedChanged" Label="סנן לפי לקוח" Variant="Variant.Outlined" Clearable="true" Dense="true"
                         ToStringFunc="ClientToString" SearchFunc="SearchClients" CoerceText="true" />
    </MudItem>
</MudGrid>

<MudTable Items="FilteredGroups" Hover="true" Elevation="2" Dense="true" Loading="loadingGroups">
    <HeaderContent>
        <MudTh>שם קבוצה</MudTh>
        <MudTh>לקוח</MudTh>
        <MudTh>התקשרות</MudTh>
        <MudTh>מאמן</MudTh>
        <MudTh>פעולות</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.GroupName</MudTd>
        <MudTd>@GetClientName(context.ClientId)</MudTd>
        <MudTd>@GetEngagementName(context.AssignId)</MudTd>
        <MudTd>@GetCoachName(context.CoachId)</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary"
                           OnClick="@(() => ViewStudents(context))" Title="צפה במשתתפים" />
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                           OnClick="@(() => EditGroupName(context))" Title="ערוך שם" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           OnClick="@(() => DeleteGroup(context))" Title="מחק קבוצה" />
        </MudTd>
    </RowTemplate>
</MudTable>

@if (selectedGroup != null && studentsByGroup.TryGetValue(selectedGroup.GroupId, out var students))
{
    <MudPaper Elevation="1" Class="pa-4 mt-4 rounded-lg">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
            <MudText Typo="Typo.h6">משתתפי קבוצת "@selectedGroup.GroupName"</MudText>
            <MudChip T="string" Size="Size.Small" Color="Color.Info">@students.Count משתתפים</MudChip>
        </MudStack>
        @if (!students.Any())
        {
            <MudText Color="Color.Default">אין משתתפים בקבוצה זו</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <th>שם</th>
                        <th>הערות</th>
                        <th>פעולות</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in students)
                    {
                        <tr>
                            <td>@s.FirstName @s.LastName</td>
                            <td>@(s.GeneralNotes ?? "—")</td>
                            <td>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               OnClick="@(() => EditStudent(s))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>
}

@code {
    private List<Coach> coaches = new();
    private List<TrainingGroup> groups = new();
    private List<Assignment> assignments = new();
    private List<ClientContract> contracts = new();
    private List<ClientOrg> clients = new();
    private Dictionary<string, List<Student>> studentsByGroup = new();
    private TrainingGroup? selectedGroup;
    private Coach? selectedCoach;
    private ClientOrg? selectedClient;
    private bool loadingGroups;

    private IEnumerable<TrainingGroup> FilteredGroups
    {
        get
        {
            var result = groups.AsEnumerable();
            if (selectedCoach != null)
                result = result.Where(g => g.CoachId == selectedCoach.CoachId);
            if (selectedClient != null)
                result = result.Where(g => g.ClientId == selectedClient.ClientId);
            return result;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            coaches = await Data.GetCoachesAsync();
            assignments = await Data.GetAssignmentsAsync();
            contracts = await Data.GetAllContractsAsync();
            clients = await Data.GetClientsAsync();
        }
        catch { }
    }

    private async Task OnCoachSelectedChanged(Coach? coach)
    {
        selectedCoach = coach;
        await LoadGroups(coach?.CoachId ?? "");
    }

    private async Task LoadGroups(string coachId)
    {
        selectedGroup = null;
        studentsByGroup.Clear();
        if (string.IsNullOrEmpty(coachId))
        {
            groups = new();
            return;
        }

        loadingGroups = true;
        try
        {
            groups = await Data.GetGroupsByCoachAsync(coachId);
            await InvokeAsync(StateHasChanged);
        }
        catch { }
        finally
        {
            loadingGroups = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task<IEnumerable<Coach>> SearchCoaches(string value, System.Threading.CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(coaches.AsEnumerable());
        var q = value.Trim();
        var result = coaches.Where(c => (c.FirstName + " " + c.LastName).StartsWith(q, StringComparison.OrdinalIgnoreCase)
                                       || c.FirstName.StartsWith(q, StringComparison.OrdinalIgnoreCase)
                                       || c.LastName.StartsWith(q, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result.AsEnumerable());
    }

    private string CoachToString(Coach? c) => c is null ? string.Empty : c.FirstName + " " + c.LastName;

    private Task<IEnumerable<ClientOrg>> SearchClients(string value, System.Threading.CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(clients.AsEnumerable());
        var q = value.Trim();
        var result = clients.Where(c => c.ClientName.StartsWith(q, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result.AsEnumerable());
    }

    private string ClientToString(ClientOrg? c) => c is null ? string.Empty : c.ClientName;

    private async Task OnClientSelectedChanged(ClientOrg? client)
    {
        selectedClient = client;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ViewStudents(TrainingGroup group)
    {
        selectedGroup = group;
        if (!studentsByGroup.ContainsKey(group.GroupId))
        {
            try
            {
                studentsByGroup[group.GroupId] = await Data.GetStudentsByGroupAsync(group.GroupId);
            }
            catch { studentsByGroup[group.GroupId] = new(); }
        }
    }

    private async Task EditStudent(Student student)
    {
        var parameters = new DialogParameters<StudentDialog> { { x => x.Student, student }, { x => x.IsEdit, true } };
        var dialog = await Dialog.ShowAsync<StudentDialog>("עריכת משתתף", parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: Student updated })
        {
            try
            {
                await Data.UpdateStudentAsync(updated);
                Snackbar.Add("משתתף עודכן", Severity.Success);
            }
            catch (Exception ex) { Snackbar.Add($"שגיאה: {ex.Message}", Severity.Error); }
        }
    }

    private string GetCoachName(string id)
    {
        var c = coaches.FirstOrDefault(x => x.CoachId == id);
        return c != null ? $"{c.FirstName} {c.LastName}" : id;
    }

    private string GetClientName(string? clientId)
    {
        if (string.IsNullOrEmpty(clientId)) return "—";
        var client = clients.FirstOrDefault(c => c.ClientId == clientId);
        return client?.ClientName ?? "—";
    }

    private string GetEngagementName(string? assignId)
    {
        if (string.IsNullOrEmpty(assignId)) return "—";
        var assignment = assignments.FirstOrDefault(a => a.AssignId == assignId);
        if (assignment == null) return "—";
        var contract = contracts.FirstOrDefault(c => c.ContractId == assignment.ContractId);
        return contract?.EngagementName ?? "—";
    }

    private string GetAssignmentLabel(Assignment a)
    {
        var client = clients.FirstOrDefault(c => c.ClientId == a.ClientId);
        var clientName = client?.ClientName ?? "לקוח";
        var contract = contracts.FirstOrDefault(c => c.ContractId == a.ContractId);
        var engName = contract?.EngagementName;
        return string.IsNullOrEmpty(engName) ? clientName : $"{engName} — {clientName}";
    }

    private async Task EditGroupName(TrainingGroup group)
    {
        var parameters = new DialogParameters<InlineEditDialog>
        {
            { x => x.Value, group.GroupName },
            { x => x.Label, "שם קבוצה" }
        };
        var dialog = await Dialog.ShowAsync<InlineEditDialog>("עריכת שם קבוצה", parameters, new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string newName } && !string.IsNullOrWhiteSpace(newName))
        {
            try
            {
                group.GroupName = newName;
                await Data.UpdateGroupAsync(group);
                Snackbar.Add("שם הקבוצה עודכן", Severity.Success);
            }
            catch (Exception ex) { Snackbar.Add($"שגיאה: {ex.Message}", Severity.Error); }
        }
    }

    private async Task DeleteGroup(TrainingGroup group)
    {
        var parameters = new DialogParameters<InlineEditDialog>();
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall };
        var confirm = await Dialog.ShowAsync<ConfirmDeleteDialog>(
            "מחיקת קבוצה",
            new DialogParameters<ConfirmDeleteDialog> { { x => x.Message, $"האם למחוק את הקבוצה \"{group.GroupName}\"? כל המשתתפים בקבוצה יימחקו גם כן." } },
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        var result = await confirm.Result;

        if (result is { Canceled: false })
        {
            try
            {
                // Delete all students in the group first
                if (studentsByGroup.TryGetValue(group.GroupId, out var students))
                {
                    foreach (var s in students)
                        await Data.DeleteStudentAsync(s.StudentId);
                }
                else
                {
                    var groupStudents = await Data.GetStudentsByGroupAsync(group.GroupId);
                    foreach (var s in groupStudents)
                        await Data.DeleteStudentAsync(s.StudentId);
                }

                await Data.DeleteGroupAsync(group.GroupId);
                groups.Remove(group);
                studentsByGroup.Remove(group.GroupId);
                if (selectedGroup?.GroupId == group.GroupId) selectedGroup = null;
                Snackbar.Add("הקבוצה נמחקה", Severity.Warning);
            }
            catch (Exception ex) { Snackbar.Add($"שגיאה: {ex.Message}", Severity.Error); }
        }
    }
}
