@page "/admin/evaluations"
@inject IDataService Data
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Style="font-weight: bold;" Class="mb-4">הערכות מאמנים - תיק סודי</MudText>
<MudAlert Severity="Severity.Warning" Dense="true" Class="mb-4">מידע HR סודי - אינו נגיש למאמנים</MudAlert>

<MudAutocomplete T="Coach" @bind-Value="selectedCoach" Label="בחר מאמן" Variant="Variant.Outlined" Clearable="true" Dense="true"
                 ToStringFunc="CoachToString" SearchFunc="SearchCoaches" CoerceText="true" Class="mb-4" />

@if (selectedCoach != null)
{
    <MudSelect T="int" @bind-Value="activeTab" Label="בחר כרטיסייה" Variant="Variant.Outlined" Dense="true" Class="mb-4">
        <MudSelectItem Value="0">הערכות ביצוע</MudSelectItem>
        <MudSelectItem Value="1">תגיות אופי</MudSelectItem>
    </MudSelect>

    @if (activeTab == 0)
    {
        <MudText Typo="Typo.subtitle1" Class="mb-2">יומן הערכות</MudText>
        <MudText Color="Color.Default">טעינת הערכות מהשרת...</MudText>
        <!-- evaluations list will load from API -->
    }
    else if (activeTab == 1)
    {
        <MudText Typo="Typo.subtitle1" Class="mb-2">מיומנויות רכות ותגיות אופי</MudText>
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
            <MudChip T="string" Color="Color.Primary" Size="Size.Medium">בעל משמעת חזקה</MudChip>
            <MudChip T="string" Color="Color.Info" Size="Size.Medium">מצוין לחינוך מיוחד</MudChip>
            <MudChip T="string" Color="Color.Warning" Size="Size.Medium">אסרטיבי</MudChip>
        </MudStack>
        <MudTextField T="string" Placeholder="הוסף תגית חדשה..." Variant="Variant.Outlined" Class="mt-3"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Add" />
    }
}

@code {
    private List<Coach> coaches = new();
    private Coach? _selectedCoach;
    private Coach? selectedCoach
    {
        get => _selectedCoach;
        set => _selectedCoach = value;
    }
    private int activeTab = 0;

    protected override async Task OnInitializedAsync()
    {
        try { coaches = await Data.GetCoachesAsync(); } catch { }
    }

    private Task<IEnumerable<Coach>> SearchCoaches(string value, System.Threading.CancellationToken cancellationToken)
    {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(coaches.AsEnumerable());
        var q = value.Trim();
        var result = coaches.Where(c => (c.FirstName + " " + c.LastName).StartsWith(q, StringComparison.OrdinalIgnoreCase)
                                       || c.FirstName.StartsWith(q, StringComparison.OrdinalIgnoreCase)
                                       || c.LastName.StartsWith(q, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(result.AsEnumerable());
    }

    private string CoachToString(Coach? c) => c is null ? string.Empty : c.FirstName + " " + c.LastName;
}
