@page "/admin/settings"
@inject IDataService Data
@inject ISnackbar Snackbar

<MudText Typo="Typo.h5" Style="font-weight: bold;" Class="mb-2">הגדרות מסמכים וחוזים</MudText>
<MudText Typo="Typo.body2" Color="Color.Default" Class="mb-4">
    הגדר אילו מסמכים וחוזים הם חובה עבור המאמנים. מסמכי חובה יוצגו כהתראה למאמן עד שיועלו, ואילו מסמכי רשות יוצגו כהתראה חד-פעמית בלבד.
</MudText>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-3">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenDialog(null))">
            הוסף סוג חדש
        </MudButton>
    </MudStack>

    <MudTable Items="configs" Hover="true" Elevation="2" Dense="true" T="TypeConfig">
        <HeaderContent>
            <MudTh>קטגוריה</MudTh>
            <MudTh>מזהה סוג</MudTh>
            <MudTh>שם לתצוגה</MudTh>
            <MudTh>חובה</MudTh>
            <MudTh>דורש תוקף</MudTh>
            <MudTh>פעיל</MudTh>
            <MudTh>סדר</MudTh>
            <MudTh>פעולות</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="קטגוריה">
                <MudChip T="string" Size="Size.Small" Color="@(context.Category == "Contract" ? Color.Secondary : Color.Info)">
                    @(context.Category == "Contract" ? "חוזה" : "מסמך")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="מזהה סוג">@context.DocType</MudTd>
            <MudTd DataLabel="שם לתצוגה">@context.DisplayName</MudTd>
            <MudTd DataLabel="חובה">
                <MudChip T="string" Size="Size.Small" Color="@(context.IsMandatory ? Color.Error : Color.Default)">
                    @(context.IsMandatory ? "חובה" : "רשות")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="דורש תוקף">@(context.RequiresExpiration ? "כן" : "לא")</MudTd>
            <MudTd DataLabel="פעיל">@(context.IsActive ? "כן" : "לא")</MudTd>
            <MudTd DataLabel="סדר">@context.SortOrder</MudTd>
            <MudTd DataLabel="פעולות">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => OpenDialog(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>

    @if (!configs.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">
            לא הוגדרו סוגי מסמכים. עד להגדרה, המערכת משתמשת ברשימת ברירת המחדל.
        </MudAlert>
    }
}

<MudDivider Class="my-6" />

<MudText Typo="Typo.h5" Style="font-weight: bold;" Class="mb-2">הגדרת קטגוריות (מאגר מידע)</MudText>
<MudText Typo="Typo.body2" Color="Color.Default" Class="mb-4">
    קטגוריות אלו מוצגות ברשימה הסגורה בעת הוספת תוכן למאגר המידע.
</MudText>

@if (loadingCategories)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-3">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => OpenCategoryDialog(null))">
            הוסף קטגוריה
        </MudButton>
    </MudStack>

    <MudTable Items="categories" Hover="true" Elevation="2" Dense="true" T="TypeConfig">
        <HeaderContent>
            <MudTh>מזהה (אנגלית)</MudTh>
            <MudTh>שם לתצוגה</MudTh>
            <MudTh>פעיל</MudTh>
            <MudTh>סדר</MudTh>
            <MudTh>פעולות</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="מזהה (אנגלית)">@context.DocType</MudTd>
            <MudTd DataLabel="שם לתצוגה">@context.DisplayName</MudTd>
            <MudTd DataLabel="פעיל">@(context.IsActive ? "כן" : "לא")</MudTd>
            <MudTd DataLabel="סדר">@context.SortOrder</MudTd>
            <MudTd DataLabel="פעולות">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="@(() => OpenCategoryDialog(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>

    @if (!categories.Any())
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">
            לא הוגדרו קטגוריות. הוסף קטגוריה כדי שתופיע ברשימת ההוספה של מאגר המידע.
        </MudAlert>
    }
}

<!-- Edit / Add Dialog -->
<MudDialog @bind-Visible="dialogVisible" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">@(editing.ConfigId == "" ? "הוספת סוג" : "עריכת סוג")</MudText>
    </TitleContent>
    <DialogContent>
        <MudSelect T="string" @bind-Value="editing.Category" Label="קטגוריה" Variant="Variant.Outlined" Class="mb-3">
            <MudSelectItem Value="@("Document")">מסמך</MudSelectItem>
            <MudSelectItem Value="@("Contract")">חוזה</MudSelectItem>
        </MudSelect>
        <MudTextField @bind-Value="editing.DocType" Label="מזהה סוג (באנגלית, ללא רווחים)" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="editing.DisplayName" Label="שם לתצוגה" Variant="Variant.Outlined" Class="mb-3" />
        <MudSwitch T="bool" @bind-Value="editing.IsMandatory" Color="Color.Error" Label="חובה" Class="mb-1" />
        <MudSwitch T="bool" @bind-Value="editing.RequiresExpiration" Color="Color.Primary" Label="דורש תאריך תוקף" Class="mb-1" />
        <MudSwitch T="bool" @bind-Value="editing.IsActive" Color="Color.Success" Label="פעיל" Class="mb-1" />
        <MudNumericField T="int" @bind-Value="editing.SortOrder" Label="סדר תצוגה" Variant="Variant.Outlined" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => dialogVisible = false)">ביטול</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveConfig"
                   Disabled="@(string.IsNullOrWhiteSpace(editing.DocType) || string.IsNullOrWhiteSpace(editing.DisplayName))">
            שמור
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Category Edit / Add Dialog -->
<MudDialog @bind-Visible="categoryDialogVisible" Options="new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true }">
    <TitleContent>
        <MudText Typo="Typo.h6">@(editingCategory.ConfigId == "" ? "הוספת קטגוריה" : "עריכת קטגוריה")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="editingCategory.DocType" Label="מזהה (באנגלית, ללא רווחים)" Variant="Variant.Outlined" Class="mb-3" />
        <MudTextField @bind-Value="editingCategory.DisplayName" Label="שם לתצוגה" Variant="Variant.Outlined" Class="mb-3" />
        <MudSwitch T="bool" @bind-Value="editingCategory.IsActive" Color="Color.Success" Label="פעיל" Class="mb-1" />
        <MudNumericField T="int" @bind-Value="editingCategory.SortOrder" Label="סדר תצוגה" Variant="Variant.Outlined" Class="mt-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => categoryDialogVisible = false)">ביטול</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveCategory"
                   Disabled="@(string.IsNullOrWhiteSpace(editingCategory.DocType) || string.IsNullOrWhiteSpace(editingCategory.DisplayName))">
            שמור
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool loading = true;
    private List<TypeConfig> configs = new();
    private TypeConfig editing = new() { ConfigId = "" };
    private bool dialogVisible;

    private bool loadingCategories = true;
    private List<TypeConfig> categories = new();
    private TypeConfig editingCategory = new() { ConfigId = "" };
    private bool categoryDialogVisible;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        await LoadCategories();
    }

    private async Task Load()
    {
        loading = true;
        try
        {
            configs = (await Data.GetTypeConfigsAsync())
                .Where(c => c.Category == "Document" || c.Category == "Contract")
                .OrderBy(c => c.Category).ThenBy(c => c.SortOrder).ToList();
        }
        catch (Exception ex) { Snackbar.Add($"שגיאה בטעינה: {ex.Message}", Severity.Error); }
        finally { loading = false; }
    }

    private void OpenDialog(TypeConfig? config)
    {
        if (config is null)
        {
            editing = new TypeConfig { ConfigId = "", SortOrder = configs.Count };
        }
        else
        {
            editing = new TypeConfig
            {
                ConfigId = config.ConfigId,
                Category = config.Category,
                DocType = config.DocType,
                DisplayName = config.DisplayName,
                IsMandatory = config.IsMandatory,
                RequiresExpiration = config.RequiresExpiration,
                IsActive = config.IsActive,
                SortOrder = config.SortOrder,
                CreatedAt = config.CreatedAt
            };
        }
        dialogVisible = true;
    }

    private async Task SaveConfig()
    {
        try
        {
            if (editing.ConfigId == "")
            {
                editing.ConfigId = Guid.NewGuid().ToString();
                await Data.CreateTypeConfigAsync(editing);
                Snackbar.Add("נוסף בהצלחה", Severity.Success);
            }
            else
            {
                await Data.UpdateTypeConfigAsync(editing);
                Snackbar.Add("נשמר בהצלחה", Severity.Success);
            }
            dialogVisible = false;
            await Load();
        }
        catch (Exception ex) { Snackbar.Add($"שגיאה בשמירה: {ex.Message}", Severity.Error); }
    }

    private async Task LoadCategories()
    {
        loadingCategories = true;
        try
        {
            categories = (await Data.GetTypeConfigsAsync())
                .Where(c => c.Category == "ResourceCategory")
                .OrderBy(c => c.SortOrder).ToList();
        }
        catch (Exception ex) { Snackbar.Add($"שגיאה בטעינה: {ex.Message}", Severity.Error); }
        finally { loadingCategories = false; }
    }

    private void OpenCategoryDialog(TypeConfig? category)
    {
        if (category is null)
        {
            editingCategory = new TypeConfig { ConfigId = "", Category = "ResourceCategory", SortOrder = categories.Count };
        }
        else
        {
            editingCategory = new TypeConfig
            {
                ConfigId = category.ConfigId,
                Category = "ResourceCategory",
                DocType = category.DocType,
                DisplayName = category.DisplayName,
                IsActive = category.IsActive,
                SortOrder = category.SortOrder,
                CreatedAt = category.CreatedAt
            };
        }
        categoryDialogVisible = true;
    }

    private async Task SaveCategory()
    {
        try
        {
            if (editingCategory.ConfigId == "")
            {
                editingCategory.ConfigId = Guid.NewGuid().ToString();
                await Data.CreateTypeConfigAsync(editingCategory);
                Snackbar.Add("נוסף בהצלחה", Severity.Success);
            }
            else
            {
                await Data.UpdateTypeConfigAsync(editingCategory);
                Snackbar.Add("נשמר בהצלחה", Severity.Success);
            }
            categoryDialogVisible = false;
            await LoadCategories();
        }
        catch (Exception ex) { Snackbar.Add($"שגיאה בשמירה: {ex.Message}", Severity.Error); }
    }
}
