@page "/admin/dashboard"
@inject IDataService Data
@inject AppState AppState
@inject NavigationManager Nav
@inject NotificationService NotificationSvc

<MudText Typo="Typo.h5" Style="font-weight: bold;" Class="mb-4">לוח בקרה - סקירה כללית</MudText>

@if (_loading)
{
    <MudOverlay Visible="true" DarkBackground="false" Absolute="false">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body1">טוען נתונים...</MudText>
        </MudStack>
    </MudOverlay>
}

@if (errorMessage != null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4">שגיאה: @errorMessage</MudAlert>
}

<MudGrid>
    <MudItem xs="6" sm="4" md="2">
        <MudCard Elevation="2" Class="pa-4 rounded-lg cursor-pointer" Style="cursor:pointer;" @onclick="@(() => Nav.NavigateTo("admin/coaches"))">
            <MudStack AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Style="font-size: 1.75rem;" />
                <MudText Typo="Typo.h5" Style="font-weight: bold;">@coachCount</MudText>
                <MudText Typo="Typo.caption">מאמנים פעילים</MudText>
            </MudStack>
        </MudCard>
    </MudItem>
    <MudItem xs="6" sm="4" md="2">
        <MudCard Elevation="2" Class="pa-4 rounded-lg" Style="cursor:pointer;" @onclick="@(() => Nav.NavigateTo("admin/clients"))">
            <MudStack AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Secondary" Style="font-size: 1.75rem;" />
                <MudText Typo="Typo.h5" Style="font-weight: bold;">@clientCount</MudText>
                <MudText Typo="Typo.caption">לקוחות פעילים</MudText>
            </MudStack>
        </MudCard>
    </MudItem>
    <MudItem xs="6" sm="4" md="2">
        <MudCard Elevation="2" Class="pa-4 rounded-lg" Style="cursor:pointer;" @onclick="@(() => Nav.NavigateTo("admin/assignments"))">
            <MudStack AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Info" Style="font-size: 1.75rem;" />
                <MudText Typo="Typo.h5" Style="font-weight: bold;">@assignmentCount</MudText>
                <MudText Typo="Typo.caption">שיבוצים פעילים</MudText>
            </MudStack>
        </MudCard>
    </MudItem>
    <MudItem xs="6" sm="4" md="2">
        <MudCard Elevation="2" Class="pa-4 rounded-lg" Style="cursor:pointer;" @onclick="@(() => Nav.NavigateTo("admin/time-reports?status=Pending_Signature"))">
            <MudStack AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.PendingActions" Color="Color.Warning" Style="font-size: 1.75rem;" />
                <MudText Typo="Typo.h5" Style="font-weight: bold;">@pendingSignatureCount</MudText>
                <MudText Typo="Typo.caption">ממתין לחתימת מאמן</MudText>
            </MudStack>
        </MudCard>
    </MudItem>
    <MudItem xs="6" sm="4" md="2">
        <MudCard Elevation="2" Class="pa-4 rounded-lg" Style="cursor:pointer;" @onclick="@(() => Nav.NavigateTo("admin/time-reports?status=Client_Approved"))">
            <MudStack AlignItems="AlignItems.Center">
                <MudIcon Icon="@Icons.Material.Filled.FactCheck" Color="Color.Info" Style="font-size: 1.75rem;" />
                <MudText Typo="Typo.h5" Style="font-weight: bold;">@clientApprovedCount</MudText>
                <MudText Typo="Typo.caption">ממתין לאישור לתשלום</MudText>
            </MudStack>
        </MudCard>
    </MudItem>
</MudGrid>

<MudGrid Class="mt-4">
    <MudItem xs="12" md="6">
        <MudCard Elevation="2" Class="pa-4 rounded-lg">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">מסמכים לאישור</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@pendingDocs.Count</MudChip>
            </MudStack>
            @if (pendingDocs.Any())
            {
                <MudList T="CoachDocument" Dense="true">
                    @foreach (var doc in pendingDocs.Take(5))
                    {
                        <MudListItem Icon="@Icons.Material.Filled.Description">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText>@GetCoachName(doc.CoachId) - @GetDocTypeText(doc.DocType)</MudText>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" Href="admin/documents">צפה</MudButton>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
                @if (pendingDocs.Count > 5)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Href="admin/documents">צפה בכל @pendingDocs.Count המסמכים</MudButton>
                }
            }
            else
            {
                <MudText Color="Color.Default">אין מסמכים ממתינים לאישור</MudText>
            }
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudCard Elevation="2" Class="pa-4 rounded-lg">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">דיווחי שעות ממתינים לטיפול</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@actionableEntries.Count</MudChip>
            </MudStack>
            @if (actionableEntries.Any())
            {
                <MudList T="TimeEntry" Dense="true">
                    @foreach (var entry in actionableEntries.Take(5))
                    {
                        <MudListItem Icon="@Icons.Material.Filled.Schedule" @onclick="@(() => Nav.NavigateTo($"admin/time-reports?status={entry.Status}"))" Style="cursor: pointer;">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Spacing="0">
                                    <MudText Typo="Typo.body2" Style="font-weight: 500;">@GetEntryCoachName(entry)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Default">
                                        @{
                                            var clientName = GetEntryClientName(entry);
                                        }
                                        @if (!string.IsNullOrEmpty(clientName))
                                        {
                                            @($"{clientName} · {entry.WorkDate:dd/MM} · {entry.HoursReported} ש'")
                                        }
                                        else
                                        {
                                            @($"{entry.WorkDate:dd/MM} · {entry.HoursReported} ש'")
                                        }
                                    </MudText>
                                </MudStack>
                                <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(entry.Status)">@GetStatusText(entry.Status)</MudChip>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
                @if (actionableEntries.Count > 5)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Primary" FullWidth="true" Href="admin/time-reports">צפה בכל @actionableEntries.Count הדיווחים</MudButton>
                }
            }
            else
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                    <MudText Color="Color.Success">כל הדיווחים טופלו</MudText>
                </MudStack>
            }
        </MudCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudCard Elevation="2" Class="pa-4 rounded-lg">
            <MudText Typo="Typo.h6" Class="mb-3">פעולות מהירות</MudText>
            <MudStack Spacing="2">
                <MudButton Variant="Variant.Outlined" FullWidth="true" StartIcon="@Icons.Material.Filled.PersonAdd" Href="admin/coaches">הוסף מאמן חדש</MudButton>
                <MudButton Variant="Variant.Outlined" FullWidth="true" StartIcon="@Icons.Material.Filled.BusinessCenter" Href="admin/clients">הוסף לקוח חדש</MudButton>
                <MudButton Variant="Variant.Outlined" FullWidth="true" StartIcon="@Icons.Material.Filled.Add" Href="admin/assignments">צור שיבוץ חדש</MudButton>
                <MudButton Variant="Variant.Outlined" FullWidth="true" StartIcon="@Icons.Material.Filled.Checklist" Href="admin/time-reports">אשר דיווחי שעות</MudButton>
            </MudStack>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private int coachCount, clientCount, assignmentCount, pendingSignatureCount, clientApprovedCount;
    private List<TimeEntry> recentEntries = new();
    private List<TimeEntry> actionableEntries = new();
    private List<CoachDocument> pendingDocs = new();
    private List<Coach> coaches = new();
    private List<Assignment> assignments = new();
    private List<ClientOrg> clients = new();
    private string? errorMessage;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load core counts in parallel
            var coachesTask = Data.GetCoachesAsync();
            var clientsTask = Data.GetClientsAsync();
            var assignmentsTask = Data.GetAssignmentsAsync();
            var entriesTask = Data.GetTimeEntriesAsync();

            await Task.WhenAll(coachesTask, clientsTask, assignmentsTask, entriesTask);

            coaches = coachesTask.Result;
            coachCount = coaches.Count;
            clients = clientsTask.Result;
            clientCount = clients.Count;

            assignments = assignmentsTask.Result;
            assignmentCount = assignments.Count(a => a.Status == "Active");

            recentEntries = entriesTask.Result;
            pendingSignatureCount = recentEntries.Count(e => e.Status == "Pending_Signature");
            clientApprovedCount = recentEntries.Count(e => e.Status == "Client_Approved");

            // Entries that still require admin attention (exclude paid/closed), oldest first
            actionableEntries = recentEntries
                .Where(e => e.Status is not "Billed_Paid")
                .OrderBy(e => e.WorkDate)
                .ToList();

            // Show partial data immediately
            _loading = false;
            StateHasChanged();

            // Load pending documents in parallel (background)
            var docTasks = coaches.Select(c => Data.GetDocumentsByCoachAsync(c.CoachId));
            var allDocs = await Task.WhenAll(docTasks);
            pendingDocs = allDocs.SelectMany(docs => docs.Where(d => d.Status == "Pending_Review")).ToList();

            // Refresh notification badge (background)
            _ = NotificationSvc.RefreshNotificationCountAsync();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            Console.WriteLine($"Dashboard error: {ex}");
        }
        finally
        {
            _loading = false;
        }
    }

    private string GetCoachName(string coachId)
    {
        var c = coaches.FirstOrDefault(x => x.CoachId == coachId);
        return c is not null ? $"{c.FirstName} {c.LastName}" : "מאמן";
    }

    private string GetEntryCoachName(TimeEntry entry)
    {
        var a = assignments.FirstOrDefault(x => x.AssignId == entry.AssignId);
        return a is not null ? GetCoachName(a.CoachId) : "מאמן";
    }

    private string GetEntryClientName(TimeEntry entry)
    {
        var a = assignments.FirstOrDefault(x => x.AssignId == entry.AssignId);
        if (a is null) return "";
        var client = clients.FirstOrDefault(x => x.ClientId == a.ClientId);
        return client?.ClientName ?? "";
    }

    private string GetDocTypeText(string t) => t switch
    {
        "National_ID_Card" => "תעודת זהות",
        "Police_Clearance" => "אישור משטרה",
        "Certification" => "תעודת הסמכה",
        "Tax_Withholding" => "ניכוי מס במקור",
        "Bank_Confirmation" => "אישור ניהול חשבון",
        "Contract" => "חוזה",
        _ => t
    };

    private Color GetStatusColor(string status) => status switch
    {
        "Pending_Signature" => Color.Warning,
        "Client_Approved" => Color.Info,
        "Admin_Approved" => Color.Success,
        "Billed_Paid" => Color.Default,
        _ => Color.Default
    };

    private string GetStatusText(string status) => status switch
    {
        "Pending_Signature" => "ממתין לחתימה",
        "Client_Approved" => "ממתין לאישור",
        "Admin_Approved" => "ממתין לתשלום",
        "Billed_Paid" => "שולם",
        _ => status
    };
}
