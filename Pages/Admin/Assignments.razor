@page "/admin/assignments"
@using System.Text.Json
@inject IDataService Data
@inject IDialogService Dialog
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject ContractGeneratorService ContractGenerator

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5" Style="font-weight: bold;">ניהול שיבוצים</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDialog">שיבוץ חדש</MudButton>
</MudStack>

<MudChipSet T="string" @bind-SelectedValue="statusFilter" SelectionMode="SelectionMode.SingleSelection" Class="mb-4">
    <MudChip Value="@("all")" Default="true">הכל</MudChip>
    <MudChip Value="@("Active")" Color="Color.Success">פעילים</MudChip>
    <MudChip Value="@("Completed")" Color="Color.Info">הושלמו</MudChip>
    <MudChip Value="@("Cancelled")" Color="Color.Error">בוטלו</MudChip>
</MudChipSet>

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudSelect T="string" @bind-Value="coachFilter" Label="מאמן" Variant="Variant.Outlined" Clearable="true" Dense="true">
            @foreach (var c in coaches)
            {
                <MudSelectItem Value="@c.CoachId">@c.FirstName @c.LastName</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudSelect T="string" @bind-Value="clientFilter" Label="לקוח" Variant="Variant.Outlined" Clearable="true" Dense="true">
            @foreach (var cl in clients)
            {
                <MudSelectItem Value="@cl.ClientId">@cl.ClientName</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>

<MudTable Items="FilteredAssignments" Hover="true" Elevation="2" Dense="true" Loading="loading" T="Assignment" OnRowClick="OnRowClicked">
    <HeaderContent>
        <MudTh>מאמן</MudTh>
        <MudTh>לקוח</MudTh>
        <MudTh>שם התקשרות</MudTh>
        <MudTh>תעריף מאמן (₪)</MudTh>
        <MudTh>שעות מוקצות</MudTh>
        <MudTh>שעות מנוצלות</MudTh>
        <MudTh>סטטוס</MudTh>
        <MudTh>לו"ז</MudTh>
        <MudTh>פעולות</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@GetCoachName(context.CoachId)</MudTd>
        <MudTd>@GetClientName(context.ClientId)</MudTd>
        <MudTd>@GetEngagementName(context)</MudTd>
        <MudTd>
            @{ var rateDisplay = GetCoachRate(context); var isDefaultRate = string.IsNullOrEmpty(context.CoachRateId); }
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText>@rateDisplay</MudText>
                @if (isDefaultRate && rateDisplay != "—")
                {
                    <MudTooltip Text="תעריף ברירת מחדל — מתעדכן אוטומטית לפי השכר העדכני של המאמן">
                        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info" />
                    </MudTooltip>
                }
            </MudStack>
        </MudTd>
        <MudTd>@context.AllocatedHours</MudTd>
        <MudTd>
            @{ var usedHrs = GetUsedHours(context.AssignId); var allocHrs = context.AllocatedHours ?? 0; }
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText>@usedHrs.ToString("0.#")</MudText>
                @if (allocHrs > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="@(usedHrs >= allocHrs ? Color.Error : usedHrs >= allocHrs * 0.75m ? Color.Warning : Color.Success)">
                        @((usedHrs / allocHrs * 100).ToString("0"))%
                    </MudChip>
                }
            </MudStack>
        </MudTd>
        <MudTd>
            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">@GetStatusText(context.Status)</MudChip>
        </MudTd>
        <MudTd>
            <MudIcon Icon="@(string.IsNullOrWhiteSpace(context.Schedule) ? Icons.Material.Outlined.EventBusy : Icons.Material.Filled.EventAvailable)"
                     Color="@(string.IsNullOrWhiteSpace(context.Schedule) ? Color.Default : Color.Success)"
                     Size="Size.Small" />
        </MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAssignment(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteAssignment(context))" />
            <MudTooltip Text="@GetContractTooltip(context.AssignId)">
                <MudIconButton Icon="@Icons.Material.Filled.Description" Size="Size.Small"
                               Color="@GetContractIconColor(context.AssignId)"
                               OnClick="@(() => SendContract(context))" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        @if (context.AssignId == expandedAssignId)
        {
            <MudTr>
                <td colspan="9" style="padding: 12px 24px; background-color: var(--mud-palette-background-gray);">
                    @{ var sched = ParseSchedule(context.Schedule); }
                    @if (sched.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Default">לא הוגדר לו"ז לשיבוץ</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight: bold;">לו"ז שיבוץ</MudText>
                        @RenderWeeklyTable(sched)
                    }
                </td>
            </MudTr>
        }
    </ChildRowContent>
</MudTable>

@code {
    private List<Assignment> assignments = new();
    private List<Coach> coaches = new();
    private List<ClientOrg> clients = new();
    private List<TimeEntry> timeEntries = new();
    private List<CoachRate> allRates = new();
    private List<ClientContract> allContracts = new();
    private List<CoachAssignmentContract> coachContracts = new();
    private string statusFilter = "all";
    private string? coachFilter;
    private string? clientFilter;
    private bool loading = true;
    private string? expandedAssignId;

    private static readonly string[] DayOrder = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    private static readonly Dictionary<string, string> DayNames = new()
    {
        ["Sunday"] = "ראשון",
        ["Monday"] = "שני",
        ["Tuesday"] = "שלישי",
        ["Wednesday"] = "רביעי",
        ["Thursday"] = "חמישי",
        ["Friday"] = "שישי",
        ["Saturday"] = "שבת"
    };

    private IEnumerable<Assignment> FilteredAssignments
    {
        get
        {
            IEnumerable<Assignment> result = assignments;
            if (statusFilter != "all")
                result = result.Where(a => a.Status == statusFilter);
            if (!string.IsNullOrEmpty(coachFilter))
                result = result.Where(a => a.CoachId == coachFilter);
            if (!string.IsNullOrEmpty(clientFilter))
                result = result.Where(a => a.ClientId == clientFilter);
            return result;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            assignments = await Data.GetAssignmentsAsync();
            coaches = await Data.GetCoachesAsync();
            clients = await Data.GetClientsAsync();
            timeEntries = await Data.GetTimeEntriesAsync();
            allContracts = await Data.GetAllContractsAsync();
            foreach (var coach in coaches)
            {
                var coachRates = await Data.GetRatesByCoachAsync(coach.CoachId);
                allRates.AddRange(coachRates);
            }
            foreach (var a in assignments)
            {
                var ac = await Data.GetContractsByAssignmentAsync(a.AssignId);
                coachContracts.AddRange(ac);
            }
        }
        catch { }
        finally { loading = false; }
    }

    private string GetEngagementName(Assignment a)
    {
        if (!string.IsNullOrEmpty(a.ContractId))
        {
            var contract = allContracts.FirstOrDefault(c => c.ContractId == a.ContractId);
            if (!string.IsNullOrWhiteSpace(contract?.EngagementName)) return contract.EngagementName;
        }
        return "כללי";
    }

    private decimal GetUsedHours(string assignId) => timeEntries.Where(e => e.AssignId == assignId).Sum(e => e.HoursReported);

    private string GetCoachRate(Assignment a)
    {
        if (!string.IsNullOrEmpty(a.CoachRateId))
        {
            var rate = allRates.FirstOrDefault(r => r.RateId == a.CoachRateId);
            if (rate != null) return $"₪{rate.HourlyRate}";
        }
        var assignRate = allRates
            .Where(r => r.CoachId == a.CoachId && r.AssignId == a.AssignId)
            .OrderByDescending(r => r.EffectiveFrom)
            .FirstOrDefault();
        if (assignRate != null) return $"₪{assignRate.HourlyRate}";
        var baseRate = allRates
            .Where(r => r.CoachId == a.CoachId && r.AssignId == null)
            .OrderByDescending(r => r.EffectiveFrom)
            .FirstOrDefault();
        return baseRate != null ? $"₪{baseRate.HourlyRate}" : "—";
    }

    private string GetCoachName(string id)
    {
        var c = coaches.FirstOrDefault(x => x.CoachId == id);
        return c != null ? $"{c.FirstName} {c.LastName}" : id;
    }

    private string GetClientName(string id)
    {
        var c = clients.FirstOrDefault(x => x.ClientId == id);
        return c?.ClientName ?? id;
    }

    private async Task OpenAddDialog()
    {
        var parameters = new DialogParameters<AssignmentDialog>
        {
            { x => x.Assignment, new Assignment() },
            { x => x.Coaches, coaches },
            { x => x.Clients, clients },
            { x => x.IsNew, true }
        };
        var dialog = await Dialog.ShowAsync<AssignmentDialog>("שיבוץ חדש", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: AssignmentDialogResult dialogResult })
        {
            try
            {
                var created = await Data.CreateAssignmentAsync(dialogResult.Assignment);

                if (dialogResult.NewRate != null)
                {
                    dialogResult.NewRate.AssignId = created.AssignId;
                    var createdRate = await Data.CreateRateAsync(dialogResult.NewRate);
                    created.CoachRateId = createdRate.RateId;
                    await Data.UpdateAssignmentAsync(created);
                }

                assignments = await Data.GetAssignmentsAsync();
                allRates.Clear();
                foreach (var coach in coaches)
                {
                    var coachRates = await Data.GetRatesByCoachAsync(coach.CoachId);
                    allRates.AddRange(coachRates);
                }
                Snackbar.Add("שיבוץ נוצר בהצלחה", Severity.Success);
            }
            catch (Exception ex) { Snackbar.Add($"שגיאה: {ex.Message}", Severity.Error); }
        }
    }

    private async Task EditAssignment(Assignment assignment)
    {
        var parameters = new DialogParameters<AssignmentDialog>
        {
            { x => x.Assignment, assignment },
            { x => x.Coaches, coaches },
            { x => x.Clients, clients },
            { x => x.IsNew, false }
        };
        var dialog = await Dialog.ShowAsync<AssignmentDialog>("עריכת שיבוץ", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: AssignmentDialogResult dialogResult })
        {
            try
            {
                if (dialogResult.NewRate != null)
                {
                    dialogResult.NewRate.AssignId = dialogResult.Assignment.AssignId;
                    var createdRate = await Data.CreateRateAsync(dialogResult.NewRate);
                    dialogResult.Assignment.CoachRateId = createdRate.RateId;
                }

                await Data.UpdateAssignmentAsync(dialogResult.Assignment);
                Snackbar.Add("שיבוץ עודכן", Severity.Success);
                assignments = await Data.GetAssignmentsAsync();
                allRates.Clear();
                foreach (var coach in coaches)
                {
                    var coachRates = await Data.GetRatesByCoachAsync(coach.CoachId);
                    allRates.AddRange(coachRates);
                }
            }
            catch (Exception ex) { Snackbar.Add($"שגיאה: {ex.Message}", Severity.Error); }
        }
    }

    private Color GetStatusColor(string s) => s switch { "Active" => Color.Success, "Completed" => Color.Info, _ => Color.Error };
    private string GetStatusText(string s) => s switch { "Active" => "פעיל", "Completed" => "הושלם", "Cancelled" => "בוטל", _ => s };

    private void OnRowClicked(TableRowClickEventArgs<Assignment> args)
    {
        expandedAssignId = expandedAssignId == args.Item.AssignId ? null : args.Item.AssignId;
    }

    private Dictionary<string, List<int>> ParseSchedule(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return new();
        try { return JsonSerializer.Deserialize<Dictionary<string, List<int>>>(json) ?? new(); }
        catch { return new(); }
    }

    private RenderFragment RenderWeeklyTable(Dictionary<string, List<int>> sched) => __builder =>
    {
        var allHours = DayOrder.Where(d => sched.ContainsKey(d)).SelectMany(d => sched[d]).Distinct().OrderBy(h => h).ToList();

        <MudSimpleTable Dense="true" Hover="true" Bordered="true" Style="max-width: 600px; direction: rtl;">
            <thead>
                <tr>
                    <th style="text-align: center;">שעה</th>
                    @foreach (var day in DayOrder)
                    {
                        <th style="text-align: center;">@DayNames[day]</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var hour in allHours)
                {
                    <tr>
                        <td style="text-align: center; font-weight: 600; direction: ltr;">@($"{hour:00}:00")</td>
                        @foreach (var day in DayOrder)
                        {
                            var active = sched.TryGetValue(day, out var hours) && hours.Contains(hour);
                            <td style="text-align: center;">
                                @if (active)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary" />
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    };

    private async Task DeleteAssignment(Assignment assignment)
    {
        var linkedEntries = timeEntries.Where(e => e.AssignId == assignment.AssignId).ToList();
        var linkedRates = allRates.Where(r => r.AssignId == assignment.AssignId).ToList();

        var lines = new List<string>();
        if (linkedEntries.Any() || linkedRates.Any())
        {
            lines.Add("מחיקת שיבוץ זה תשפיע על:");
            if (linkedEntries.Any())
                lines.Add($"• {linkedEntries.Count} דיווחי שעות");
            if (linkedRates.Any())
                lines.Add($"• {linkedRates.Count} תעריפים מקושרים");
            lines.Add("");
            lines.Add("כל הרשומות המקושרות יימחקו. להמשיך?");
        }
        else
        {
            lines.Add("למחוק שיבוץ זה?");
        }

        var confirmed = await JS.InvokeAsync<bool>("confirm", string.Join("\n", lines));
        if (!confirmed) return;

        try
        {
            // Delete linked time entries
            foreach (var entry in linkedEntries)
                await Data.DeleteTimeEntryAsync(entry.EntryId);

            // Delete linked rates
            foreach (var rate in linkedRates)
                await Data.DeleteRateAsync(rate.RateId);

            // Unlink coach_rate_id references pointing to this assignment's rates
            // (already deleted above, but other assignments may reference them)

            await Data.DeleteAssignmentAsync(assignment.AssignId);

            assignments = await Data.GetAssignmentsAsync();
            timeEntries = await Data.GetTimeEntriesAsync();
            allRates.Clear();
            foreach (var coach in coaches)
            {
                var coachRates = await Data.GetRatesByCoachAsync(coach.CoachId);
                allRates.AddRange(coachRates);
            }
            Snackbar.Add("שיבוץ נמחק", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add($"שגיאה: {ex.Message}", Severity.Error); }
    }

    // ===== Contract Methods =====

    private string GetContractStatus(string assignId)
    {
        var c = coachContracts.Where(x => x.AssignId == assignId).OrderByDescending(x => x.CreatedAt).FirstOrDefault();
        return c?.Status ?? "None";
    }

    private Color GetContractIconColor(string assignId) => GetContractStatus(assignId) switch
    {
        "Signed" => Color.Success,
        "Pending" => Color.Warning,
        _ => Color.Default
    };

    private string GetContractTooltip(string assignId) => GetContractStatus(assignId) switch
    {
        "Signed" => "חוזה חתום — לחץ לצפייה",
        "Pending" => "חוזה ממתין לחתימה",
        _ => "שלח חוזה לחתימה"
    };

    private async Task SendContract(Assignment assignment)
    {
        var existingStatus = GetContractStatus(assignment.AssignId);

        if (existingStatus == "Signed")
        {
            // Preview signed contract
            var signed = coachContracts.First(x => x.AssignId == assignment.AssignId && x.Status == "Signed");
            await JS.InvokeVoidAsync("contractPdf.preview", signed.HtmlContent);
            return;
        }

        if (existingStatus == "Pending")
        {
            Snackbar.Add("חוזה כבר נשלח וממתין לחתימת המאמן", Severity.Info);
            return;
        }

        // Generate contract
        var coach = coaches.FirstOrDefault(c => c.CoachId == assignment.CoachId);
        var client = clients.FirstOrDefault(c => c.ClientId == assignment.ClientId);
        if (coach == null || client == null)
        {
            Snackbar.Add("נתוני מאמן/לקוח חסרים", Severity.Error);
            return;
        }

        var clientContract = !string.IsNullOrEmpty(assignment.ContractId)
            ? allContracts.FirstOrDefault(c => c.ContractId == assignment.ContractId)
            : null;

        // Get coach rate
        decimal rate = 0;
        if (!string.IsNullOrEmpty(assignment.CoachRateId))
        {
            var r = allRates.FirstOrDefault(x => x.RateId == assignment.CoachRateId);
            if (r != null) rate = r.HourlyRate;
        }
        else
        {
            var r = allRates.Where(x => x.CoachId == assignment.CoachId && x.AssignId == assignment.AssignId)
                .OrderByDescending(x => x.EffectiveFrom).FirstOrDefault()
                ?? allRates.Where(x => x.CoachId == assignment.CoachId && x.AssignId == null)
                .OrderByDescending(x => x.EffectiveFrom).FirstOrDefault();
            if (r != null) rate = r.HourlyRate;
        }

        try
        {
            var html = await ContractGenerator.GenerateHtmlAsync(assignment, coach, client, clientContract, rate);

            var coachContract = new CoachAssignmentContract
            {
                AssignId = assignment.AssignId,
                CoachId = assignment.CoachId,
                ClientId = assignment.ClientId,
                CoachRate = rate,
                AllocatedHours = assignment.AllocatedHours,
                HtmlContent = html,
                Status = "Pending"
            };

            var created = await Data.CreateCoachContractAsync(coachContract);
            coachContracts.Add(created);
            Snackbar.Add($"חוזה נשלח לחתימת {coach.FirstName} {coach.LastName}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"שגיאה ביצירת חוזה: {ex.Message}", Severity.Error);
        }
    }
}
