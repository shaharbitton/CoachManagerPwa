<MudDialog>
    <DialogContent>
        <MudText>@Message</MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">ביטול</MudButton>
        <MudButton Color="Color.Default" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => Select("view"))">צפה בחוזה</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Email" OnClick="@(() => Select("remind"))">שלח תזכורת במייל</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Message { get; set; } = "";

    private void Select(string action) => MudDialog.Close(DialogResult.Ok(action));
    private void Cancel() => MudDialog.Cancel();
}
