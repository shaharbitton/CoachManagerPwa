@code {
    [Parameter] public List<Assignment> Assignments { get; set; } = new();
    [Parameter] public List<TimeEntry> TimeEntries { get; set; } = new();
    [Parameter] public List<ClientContract> AllContracts { get; set; } = new();

    private int month = DateTime.Now.Month; private int year = DateTime.Now.Year;
    private static readonly string[] Months = ["", "ינואר", "פברואר", "מרץ", "אפריל", "מאי", "יוני", "יולי", "אוגוסט", "ספטמבר", "אוקטובר", "נובמבר", "דצמבר"];
    private static readonly string[] Approved = ["Admin_Approved", "Billed_Paid"];

    private decimal CalcIncome(IEnumerable<TimeEntry> entries) => entries.Sum(e =>
    {
        var a = Assignments.FirstOrDefault(a => a.AssignId == e.AssignId);
        if (a == null) return 0m;
        var ct = !string.IsNullOrEmpty(a.ContractId) ? AllContracts.FirstOrDefault(c => c.ContractId == a.ContractId) : null;
        return e.HoursReported * (ct?.BillingRatePerHour ?? 0);
    });

    private string Delta(decimal cur, decimal prev) => prev == 0 ? "—" : $"{(cur - prev) / prev * 100:+0;-0}%";
}

<MudGrid Class="mb-4">
    <MudItem xs="6" sm="3">
        <MudSelect T="int" @bind-Value="month" Label="חודש" Variant="Variant.Outlined" Dense="true">
            @for (int m = 1; m <= 12; m++) { var mm = m; <MudSelectItem Value="mm">@Months[mm]</MudSelectItem> }
        </MudSelect>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudNumericField T="int" @bind-Value="year" Label="שנה" Variant="Variant.Outlined" Min="2020" Max="2030" />
    </MudItem>
</MudGrid>

@{
    var curEntries = TimeEntries.Where(e => Approved.Contains(e.Status) && e.WorkDate.Month == month && e.WorkDate.Year == year).ToList();
    var pm = month == 1 ? 12 : month - 1;
    var py = month == 1 ? year - 1 : year;
    var prevEntries = TimeEntries.Where(e => Approved.Contains(e.Status) && e.WorkDate.Month == pm && e.WorkDate.Year == py).ToList();

    var curHours = curEntries.Sum(e => e.HoursReported);
    var prevHours = prevEntries.Sum(e => e.HoursReported);
    var curIncome = CalcIncome(curEntries);
    var prevIncome = CalcIncome(prevEntries);
    var curCoaches = curEntries.Select(e => Assignments.FirstOrDefault(a => a.AssignId == e.AssignId)?.CoachId).Where(x => x != null).Distinct().Count();
    var prevCoaches = prevEntries.Select(e => Assignments.FirstOrDefault(a => a.AssignId == e.AssignId)?.CoachId).Where(x => x != null).Distinct().Count();
}

<MudSimpleTable Dense="true" Hover="true" Bordered="true" Style="direction: rtl; max-width: 500px;">
    <thead><tr><th>מדד</th><th>@Months[month] @year</th><th>@Months[pm] @py</th><th>שינוי</th></tr></thead>
    <tbody>
        <tr>
            <td>שעות מדווחות</td><td>@curHours.ToString("0.#")</td><td>@prevHours.ToString("0.#")</td>
            <td><MudChip T="string" Size="Size.Small" Color="@(curHours >= prevHours ? Color.Success : Color.Error)">@(curHours >= prevHours ? "↑" : "↓") @Delta(curHours, prevHours)</MudChip></td>
        </tr>
        <tr>
            <td>הכנסות</td><td>₪@curIncome.ToString("N0")</td><td>₪@prevIncome.ToString("N0")</td>
            <td><MudChip T="string" Size="Size.Small" Color="@(curIncome >= prevIncome ? Color.Success : Color.Error)">@(curIncome >= prevIncome ? "↑" : "↓") @Delta(curIncome, prevIncome)</MudChip></td>
        </tr>
        <tr>
            <td>מאמנים פעילים</td><td>@curCoaches</td><td>@prevCoaches</td>
            <td><MudChip T="string" Size="Size.Small" Color="@(curCoaches >= prevCoaches ? Color.Success : Color.Error)">@(curCoaches >= prevCoaches ? "↑" : "↓") @Delta(curCoaches, prevCoaches)</MudChip></td>
        </tr>
    </tbody>
</MudSimpleTable>
