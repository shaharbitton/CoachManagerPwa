@code {
    [Parameter] public List<ClientOrg> Clients { get; set; } = new();
    [Parameter] public List<Assignment> Assignments { get; set; } = new();
    [Parameter] public List<TimeEntry> TimeEntries { get; set; } = new();
    [Parameter] public List<CoachRate> AllRates { get; set; } = new();
    [Parameter] public List<ClientContract> AllContracts { get; set; } = new();

    private int month = DateTime.Now.Month; private int year = DateTime.Now.Year; private string? clientFilter;
    private static readonly string[] Months = ["", "ינואר", "פברואר", "מרץ", "אפריל", "מאי", "יוני", "יולי", "אוגוסט", "ספטמבר", "אוקטובר", "נובמבר", "דצמבר"];
    private static readonly string[] Approved = ["Admin_Approved", "Billed_Paid"];
    private string ClientName(string id) => Clients.FirstOrDefault(c => c.ClientId == id)?.ClientName ?? "—";

    private decimal RateFor(Assignment a)
    {
        if (!string.IsNullOrEmpty(a.CoachRateId)) { var r = AllRates.FirstOrDefault(x => x.RateId == a.CoachRateId); if (r != null) return r.HourlyRate; }
        var rate = AllRates.Where(r => r.CoachId == a.CoachId && r.AssignId == a.AssignId).OrderByDescending(r => r.EffectiveFrom).FirstOrDefault()
            ?? AllRates.Where(r => r.CoachId == a.CoachId && r.AssignId == null).OrderByDescending(r => r.EffectiveFrom).FirstOrDefault();
        return rate?.HourlyRate ?? 0;
    }

    private record ProfitRow(string ClientId, decimal Hours, decimal Income, decimal Expense, decimal Profit, decimal Pct);

    private List<ProfitRow> GetRows()
    {
        var monthEntries = TimeEntries.Where(e => Approved.Contains(e.Status) && e.WorkDate.Month == month && e.WorkDate.Year == year).ToList();
        var clientIds = string.IsNullOrEmpty(clientFilter) ? Clients.Select(c => c.ClientId).ToList() : new List<string> { clientFilter };

        return clientIds.Select(cid =>
        {
            var ca = Assignments.Where(a => a.ClientId == cid).ToList();
            var entries = monthEntries.Where(e => ca.Any(a => a.AssignId == e.AssignId)).ToList();
            var hours = entries.Sum(e => e.HoursReported);
            var income = entries.Sum(e => { var a = ca.First(a => a.AssignId == e.AssignId); var ct = !string.IsNullOrEmpty(a.ContractId) ? AllContracts.FirstOrDefault(c => c.ContractId == a.ContractId) : null; return e.HoursReported * (ct?.BillingRatePerHour ?? 0); });
            var expense = entries.Sum(e => { var a = ca.First(a => a.AssignId == e.AssignId); return e.HoursReported * RateFor(a); });
            var profit = income - expense;
            var pct = income > 0 ? profit / income * 100 : 0;
            return new ProfitRow(cid, hours, income, expense, profit, pct);
        }).Where(r => r.Hours > 0).OrderByDescending(r => r.Profit).ToList();
    }
}

<MudGrid Class="mb-4">
    <MudItem xs="6" sm="3">
        <MudSelect T="int" @bind-Value="month" Label="חודש" Variant="Variant.Outlined" Dense="true">
            @for (int m = 1; m <= 12; m++) { var mm = m; <MudSelectItem Value="mm">@Months[mm]</MudSelectItem> }
        </MudSelect>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudNumericField T="int" @bind-Value="year" Label="שנה" Variant="Variant.Outlined" Min="2020" Max="2030" />
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudSelect T="string" @bind-Value="clientFilter" Label="לקוח" Variant="Variant.Outlined" Clearable="true" Dense="true">
            @foreach (var cl in Clients) { <MudSelectItem Value="@cl.ClientId">@cl.ClientName</MudSelectItem> }
        </MudSelect>
    </MudItem>
</MudGrid>

@{ var rows = GetRows(); }
<MudSimpleTable Dense="true" Hover="true" Bordered="true" Style="direction: rtl;">
    <thead><tr><th>לקוח</th><th>שעות</th><th>הכנסה (₪)</th><th>הוצאה (₪)</th><th>רווח (₪)</th><th>% רווח</th></tr></thead>
    <tbody>
        @foreach (var r in rows)
        {
            <tr>
                <td>@ClientName(r.ClientId)</td>
                <td>@r.Hours.ToString("0.#")</td>
                <td>₪@r.Income.ToString("N0")</td>
                <td>₪@r.Expense.ToString("N0")</td>
                <td style="color: @(r.Profit >= 0 ? "green" : "red")">₪@r.Profit.ToString("N0")</td>
                <td><MudChip T="string" Size="Size.Small" Color="@(r.Pct >= 30 ? Color.Success : r.Pct >= 15 ? Color.Warning : Color.Error)">@r.Pct.ToString("0")%</MudChip></td>
            </tr>
        }
        @if (rows.Any())
        {
            <tr style="font-weight: bold; background-color: var(--mud-palette-background-gray);">
                <td>סה"כ</td><td>@rows.Sum(r => r.Hours).ToString("0.#")</td><td>₪@rows.Sum(r => r.Income).ToString("N0")</td><td>₪@rows.Sum(r => r.Expense).ToString("N0")</td><td>₪@rows.Sum(r => r.Profit).ToString("N0")</td><td></td>
            </tr>
        }
    </tbody>
</MudSimpleTable>
